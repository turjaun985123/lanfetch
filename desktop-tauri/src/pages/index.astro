---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>LanFetch</title>
    <script is:inline>
      // Theme before first paint (no flash): stored choice wins,
      // otherwise follow the OS.
      try {
        var t = localStorage.getItem('lanfetch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script is:inline>
      // Rail mode before first paint (Agents 12/13): compact in the
      // 768-1023 band, or at >=1024 when the user collapsed it
      // (localStorage 'lanfetch-rail'). Below 768 the rail becomes
      // the bottom bar and this attribute is irrelevant.
      try {
        var w = window.innerWidth;
        var rail = 'expanded';
        if (w >= 768 && w < 1024) rail = 'compact';
        else if (w >= 1024 && localStorage.getItem('lanfetch-rail') === 'compact')
          rail = 'compact';
        document.documentElement.dataset.rail = rail;
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Icon sprite (DESIGN.md / Agent 10): one definition per
         glyph, referenced by <use href="#i-…"> everywhere, static
         and JS-rendered alike. Lucide-style: 24 grid, stroke 2,
         round caps, currentColor. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-logo" viewBox="0 0 32 32">
          <rect width="32" height="32" rx="8" style="fill:var(--accent)"/>
          <g fill="none" style="stroke:var(--on-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 6.5v11"/>
            <path d="m10.5 13 5.5 5.5L21.5 13"/>
            <path d="M9 24.5h14"/>
          </g>
        </symbol>
        <symbol id="i-library" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="4" width="4.5" height="16" rx="1"/>
            <rect x="9.75" y="4" width="4.5" height="16" rx="1"/>
            <path d="M17.6 5.4 21 4.4l2.1 13.2-3.4 1z"/>
          </g>
        </symbol>
        <symbol id="i-transfers" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v11"/>
            <path d="m7 9.5 5 5 5-5"/>
            <path d="M4 21h16"/>
          </g>
        </symbol>
        <symbol id="i-servers" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="7" rx="2"/>
            <rect x="3" y="13" width="18" height="7" rx="2"/>
            <circle cx="7.5" cy="7.5" r="0.6" fill="currentColor" stroke="none"/>
            <circle cx="7.5" cy="16.5" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-settings" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h9M19 6h1"/>
            <circle cx="16" cy="6" r="2"/>
            <path d="M4 12h3M13 12h7"/>
            <circle cx="10" cy="12" r="2"/>
            <path d="M4 18h11M19 18h1"/>
            <circle cx="17" cy="18" r="2"/>
          </g>
        </symbol>
        <symbol id="i-search" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m16.5 16.5 4.5 4.5"/>
          </g>
        </symbol>
        <symbol id="i-refresh" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-2.64-6.36"/>
            <path d="M21 3v6h-6"/>
          </g>
        </symbol>
        <symbol id="i-retry" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 2.64-6.36"/>
            <path d="M3 3v6h6"/>
          </g>
        </symbol>
        <symbol id="i-back" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12H4"/>
            <path d="m11 5-7 7 7 7"/>
          </g>
        </symbol>
        <symbol id="i-close" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 5l14 14M19 5L5 19"/>
          </g>
        </symbol>
        <symbol id="i-check" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12.5 9.5 18 20 6.5"/>
          </g>
        </symbol>
        <symbol id="i-warning" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.3 4.1 2.9 17a2 2 0 0 0 1.7 3h14.8a2 2 0 0 0 1.7-3L13.7 4.1a2 2 0 0 0-3.4 0Z"/>
            <path d="M12 9v4"/>
            <circle cx="12" cy="16.5" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-info" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 11v5"/>
            <circle cx="12" cy="8" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-download" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12"/>
            <path d="m7 10.5 5 5 5-5"/>
            <path d="M3 15v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4"/>
          </g>
        </symbol>
        <symbol id="i-pause" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="4" width="4" height="16" rx="1"/>
            <rect x="14" y="4" width="4" height="16" rx="1"/>
          </g>
        </symbol>
        <symbol id="i-play" viewBox="0 0 24 24">
          <path d="M8 5.4v13.2a1 1 0 0 0 1.52.86l11-6.6a1 1 0 0 0 0-1.72l-11-6.6A1 1 0 0 0 8 5.4Z" fill="currentColor"/>
        </symbol>
        <symbol id="i-trash" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h16"/>
            <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            <path d="M6.5 7l.9 12.2A2 2 0 0 0 9.4 21h5.2a2 2 0 0 0 2-1.8L17.5 7"/>
            <path d="M10 11v6M14 11v6"/>
          </g>
        </symbol>
        <symbol id="i-redownload" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 2.64-6.36"/>
            <path d="M3 3v6h6"/>
            <path d="M8 21h8"/>
          </g>
        </symbol>
        <symbol id="i-star" viewBox="0 0 24 24">
          <path d="M12 3.6l2.9 5.8 6.3.9-4.6 4.3 1.2 6.4L12 17.8 6.2 21l1.2-6.4L2.8 10.3l6.3-.9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </symbol>
        <symbol id="i-star-filled" viewBox="0 0 24 24">
          <path d="M12 3.6l2.9 5.8 6.3.9-4.6 4.3 1.2 6.4L12 17.8 6.2 21l1.2-6.4L2.8 10.3l6.3-.9z" fill="currentColor"/>
        </symbol>
        <symbol id="i-plus" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </g>
        </symbol>
        <symbol id="i-chevron-down" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </g>
        </symbol>
        <symbol id="i-panel-left" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <path d="M9.5 4v16"/>
          </g>
        </symbol>
        <symbol id="i-film" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <path d="M8 4v16M16 4v16M3 9h5M3 15h5M16 9h5M16 15h5"/>
          </g>
        </symbol>
        <symbol id="i-sun" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </g>
        </symbol>
        <symbol id="i-moon" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 13.6A8.5 8.5 0 1 1 10.4 4 6.8 6.8 0 0 0 20 13.6Z"/>
          </g>
        </symbol>
        <symbol id="i-monitor" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="12" rx="2"/>
            <path d="M9 20h6M12 16v4"/>
          </g>
        </symbol>
        <symbol id="i-globe" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18"/>
            <path d="M12 3a13.8 13.8 0 0 1 0 18 13.8 13.8 0 0 1 0-18Z"/>
          </g>
        </symbol>
        <symbol id="i-hard-drive" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12H2"/>
            <path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1Z"/>
            <circle cx="12" cy="16" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-arrow-up-circle" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 16V8"/>
            <path d="m8.5 11.5 3.5-3.5 3.5 3.5"/>
          </g>
        </symbol>
        <symbol id="i-clock" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3 2"/>
          </g>
        </symbol>
      </defs>
    </svg>
    <div class="flex h-full">
      <!-- Rail: ONE nav element for every band (Agents 11-13).
           >=1024 expanded or user-collapsed, 768-1023 forced
           compact, <768 the same element becomes the bottom bar —
           so show(), the badge and the shortcuts can never desync. -->
      <aside id="rail" class="rail flex shrink-0 bg-surface">
        <div class="brand-row">
          <svg class="ic ic-24 brand-glyph" aria-hidden="true"><use href="#i-logo" /></svg>
          <span class="nav-label text-page font-semibold">lanfetch</span>
          <button
            id="rail-toggle"
            class="icon-btn ml-auto"
            type="button"
            aria-expanded="true"
            aria-controls="nav"
            aria-label="Collapse sidebar"
            title="Collapse sidebar"
          >
            <svg class="ic" aria-hidden="true"><use href="#i-panel-left" /></svg>
          </button>
        </div>
        <nav class="flex gap-1" id="nav" aria-label="Primary">
          <button data-view="library" class="nav-item" aria-label="Library" title="Library">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-library" /></svg>
            <span class="nav-label">Library</span>
          </button>
          <button data-view="transfers" class="nav-item" aria-label="Transfers" title="Transfers">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-transfers" /></svg>
            <span class="nav-label">Transfers</span>
            <span id="nav-badge" class="badge-count hidden" aria-hidden="true"></span>
          </button>
          <button data-view="servers" class="nav-item" aria-label="Servers" title="Servers">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-servers" /></svg>
            <span class="nav-label">Servers</span>
            <span id="rail-servers-dot" class="rail-dot status-dot" aria-hidden="true"></span>
          </button>
          <button data-view="settings" class="nav-item" aria-label="Settings" title="Settings">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-settings" /></svg>
            <span class="nav-label">Settings</span>
          </button>
        </nav>
        <div class="rail-meta section-label mt-auto px-4 pb-1">Servers</div>
        <div class="rail-meta px-4 pb-2 text-secondary text-ink-2" id="rail-servers">…</div>
        <div class="rail-meta border-t border-hairline px-4 py-3 text-caption text-ink-3" id="version"></div>
      </aside>

      <!-- Content -->
      <main class="min-w-0 flex-1 overflow-y-auto">
        <!-- Library -->
        <section data-screen="library">
          <header class="screen-header">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="page-title">Library</h1>
              <div class="search-wrap relative min-w-0 flex-1 max-[767px]:order-3 max-[767px]:w-full max-[767px]:flex-none md:ml-auto md:max-w-[420px]">
                <svg class="ic ic-16 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" aria-hidden="true"><use href="#i-search" /></svg>
                <label class="sr-only" for="lib-search">Search titles</label>
                <input
                  id="lib-search"
                  type="search"
                  placeholder="Search titles…"
                  autocomplete="off"
                  class="w-full rounded-full border border-border-strong bg-surface py-1.5 pl-9 pr-16 text-control text-ink outline-none placeholder:text-ink-3 focus:border-accent"
                />
                <button
                  id="lib-clear"
                  type="button"
                  class="icon-btn absolute right-1 top-1/2 hidden h-7 w-7 -translate-y-1/2"
                  aria-label="Clear search"
                >
                  <svg class="ic ic-16" aria-hidden="true"><use href="#i-close" /></svg>
                </button>
                <kbd class="search-hint pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded-sm border border-hairline bg-raised px-1.5 py-0.5 text-caption text-ink-3">Ctrl K</kbd>
              </div>
              <button
                id="lib-refresh"
                class="icon-btn max-[767px]:order-2 max-[767px]:ml-auto"
                aria-label="Refresh catalog"
                title="Refresh catalog"
              >
                <svg class="ic" aria-hidden="true"><use href="#i-refresh" /></svg>
              </button>
            </div>
            <p class="status-line" id="lib-status" role="status" aria-live="polite">…</p>
            <div
              id="chips"
              class="mt-3 flex gap-2 overflow-x-auto pb-1"
              role="group"
              aria-label="Categories"
            ></div>
          </header>
          <div class="px-6 max-[767px]:px-4">
            <div id="lib-banner" class="banner mt-4 hidden" role="alert">
              <span id="lib-banner-icon" class="text-failed"></span>
              <p id="lib-banner-text" class="min-w-0 flex-1 text-body"></p>
              <button id="lib-banner-retry" class="btn btn-ghost btn-sm shrink-0"></button>
            </div>
          </div>
          <div id="onboarding" class="hidden px-6 pt-5">
            <div class="rounded-2xl border border-hairline bg-surface px-5 py-4">
              <p class="text-[15px] font-semibold">Welcome to LanFetch</p>
              <p class="mt-1 max-w-[560px] text-[12.5px] leading-relaxed text-ink-2">
                Your DhakaFlix servers are already set up — no configuration
                needed. Browse the Library, open a title, and download with
                byte-exact resume: pause anything, close the app, and it
                continues where it left off.
              </p>
              <div class="mt-3 flex gap-2">
                <button
                  id="ob-done"
                  class="rounded-full bg-accent px-4 py-1.5 text-[12.5px] font-semibold text-white"
                >
                  Start browsing
                </button>
                <button
                  id="ob-check"
                  class="rounded-full border border-hairline px-4 py-1.5 text-[12.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Check servers first
                </button>
              </div>
            </div>
          </div>
          <div
            id="grid"
            class="poster-grid"
            role="group"
            aria-label="Titles"
          ></div>
          <div id="lib-empty" class="empty-state hidden" role="status">
            <span id="lib-empty-icon" class="text-ink-3"></span>
            <h3 id="lib-empty-title" class="mt-3 text-heading font-semibold"></h3>
            <p id="lib-empty-body" class="mt-1 max-w-[420px] text-body text-ink-2"></p>
            <div class="mt-4 flex gap-2">
              <button id="lib-empty-action" class="btn btn-primary btn-sm"></button>
              <button id="lib-empty-action-2" class="btn btn-ghost btn-sm hidden"></button>
            </div>
          </div>
          <div id="sentinel" class="h-2"></div>
        </section>

        <!-- Detail -->
        <section data-screen="detail" class="hidden">
          <header class="screen-header">
            <button
              id="detail-back"
              class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
            >
              ← Library
            </button>
          </header>
          <div class="flex gap-6 px-6 py-5">
            <div class="w-[180px] shrink-0">
              <div
                class="relative aspect-[2/3] overflow-hidden rounded-xl border border-hairline bg-raised"
              >
                <div
                  id="detail-initials"
                  class="absolute inset-0 flex items-center justify-center text-[34px] font-semibold text-ink-3"
                ></div>
                <img
                  id="detail-poster"
                  class="absolute inset-0 hidden h-full w-full object-cover"
                  draggable="false"
                  alt=""
                />
              </div>
              <button
                id="detail-fav"
                class="mt-3 w-full rounded-full border border-hairline px-3 py-1.5 text-[12.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
              >
                ☆ Favorite
              </button>
            </div>
            <div class="min-w-0 flex-1">
              <h2
                id="detail-title"
                class="text-[20px] font-semibold leading-snug"
              ></h2>
              <p id="detail-meta" class="mt-1 text-[12.5px] text-ink-2"></p>
              <p id="detail-status" class="mt-1 text-[12px] text-ink-3"></p>
              <div id="detail-files" class="mt-4 flex flex-col gap-2"></div>
            </div>
          </div>
        </section>

        <!-- Transfers -->
        <section data-screen="transfers" class="hidden">
          <header class="screen-header">
            <div class="flex items-center justify-between">
              <h1 class="page-title">Transfers</h1>
              <div class="flex gap-1.5">
                <button
                  id="tr-pause-all"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Pause all
                </button>
                <button
                  id="tr-resume-all"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Resume all
                </button>
                <button
                  id="tr-clear"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Clear completed
                </button>
              </div>
            </div>
            <p class="status-line" id="tr-status">…</p>
          </header>
          <div class="flex flex-col gap-2.5 px-6 py-5" id="tasks"></div>
        </section>

        <!-- Servers -->
        <section data-screen="servers" class="hidden">
          <header class="screen-header">
            <h1 class="page-title">Servers</h1>
            <p class="status-line" id="srv-status">…</p>
          </header>
          <div class="px-6 pt-5">
            <div
              class="flex flex-wrap items-center gap-2 rounded-2xl border border-hairline bg-surface px-4 py-3"
            >
              <input
                id="srv-name"
                type="text"
                placeholder="Server name"
                autocomplete="off"
                class="w-40 rounded-full border border-hairline bg-raised px-3 py-1.5 text-[12.5px] text-ink outline-none placeholder:text-ink-3 focus:border-accent"
              />
              <input
                id="srv-url"
                type="text"
                placeholder="http://192.168.1.10/movies/"
                autocomplete="off"
                class="min-w-56 flex-1 rounded-full border border-hairline bg-raised px-3 py-1.5 text-[12.5px] text-ink outline-none placeholder:text-ink-3 focus:border-accent"
              />
              <button
                id="srv-add"
                class="rounded-full bg-accent px-4 py-1.5 text-[12.5px] font-semibold text-white"
              >
                Add server
              </button>
              <p id="srv-error" class="w-full text-[12px] text-failed"></p>
            </div>
          </div>
          <div class="flex flex-col gap-2 px-6 py-5" id="probes"></div>
        </section>

        <!-- Settings -->
        <section data-screen="settings" class="hidden">
          <header class="screen-header">
            <h1 class="page-title">Settings</h1>
            <p class="status-line">Applies immediately — no Save button.</p>
          </header>
          <div class="flex max-w-[560px] flex-col gap-6 px-6 py-5">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Appearance</p>
              <div class="mt-2 flex gap-1 rounded-full bg-raised p-1" id="theme-switch">
                <button data-theme-choice="system" class="theme-btn">System</button>
                <button data-theme-choice="light" class="theme-btn">Light</button>
                <button data-theme-choice="dark" class="theme-btn">Dark</button>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Download engine</p>
              <div class="mt-2 flex flex-col gap-2.5 text-[13px]">
                <label class="flex items-center gap-3">
                  <span class="w-44 shrink-0 text-ink-2">Connections per file</span>
                  <select id="set-connections" class="rounded-lg border border-hairline bg-raised px-2 py-1.5 text-ink">
                    <option>1</option><option>2</option><option>4</option><option>6</option>
                    <option>8</option><option>12</option><option>16</option><option>24</option><option>32</option>
                  </select>
                </label>
                <label class="flex items-center gap-3">
                  <span class="w-44 shrink-0 text-ink-2">Downloads at once</span>
                  <select id="set-concurrent" class="rounded-lg border border-hairline bg-raised px-2 py-1.5 text-ink">
                    <option>1</option><option>2</option><option>3</option><option>4</option>
                    <option>6</option><option>8</option><option>12</option><option>16</option>
                  </select>
                </label>
                <label class="flex items-center gap-3">
                  <span class="w-44 shrink-0 text-ink-2">Language</span>
                  <select id="set-language" class="rounded-lg border border-hairline bg-raised px-2 py-1.5 text-ink">
                    <option value="system">System</option>
                    <option value="en">English</option>
                    <option value="bn">বাংলা</option>
                  </select>
                </label>
                <p class="text-[12px] text-ink-3">
                  Engine values apply to new downloads immediately. The
                  language choice is saved now and translates the whole
                  interface in the polish update.
                </p>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Storage</p>
              <dl class="mt-2 flex flex-col gap-1.5 text-[13px]">
                <div class="flex gap-2"><dt class="w-28 shrink-0 text-ink-2">Downloads</dt><dd class="min-w-0 truncate" id="set-dl-dir">…</dd></div>
                <div class="flex gap-2"><dt class="w-28 shrink-0 text-ink-2">App data</dt><dd class="min-w-0 truncate" id="set-data-dir">…</dd></div>
              </dl>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Updates</p>
              <p id="set-update" class="mt-2 text-[13px] text-ink-2">Checking…</p>
            </div>
          </div>
        </section>
      </main>
    </div>


    <script>
      import {
        addSource,
        clearCompletedDownloads,
        feedNext,
        feedOpen,
        getBootstrap,
        getCategories,
        getDownloads,
        getTitleDetail,
        onDownloadsChanged,
        pauseDownload,
        posterSrcs,
        probeSources,
        checkUpdate,
        getFavorites,
        pauseAllDownloads,
        redownloadDownload,
        removeDownload,
        removeSource,
        resumeAllDownloads,
        resumeDownload,
        searchTitles,
        setSourceEnabled,
        startDownload,
        toggleFavorite,
        updateSettings,
      } from '../lib/api';
      import type {
        BootstrapDto,
        CategoryDto,
        DownloadListDto,
        FeedPageDto,
        FileDto,
        SettingsDto,
        SourceDto,
        SourceProbeDto,
        TaskDto,
        TitleDetailDto,
        TitleDto,
      } from '../lib/api';
      import {
        STATE_LABEL,
        dotClass,
        fmtBytes,
        fmtEta,
        fmtSpeed,
        initials,
      } from '../lib/format';
      import { el, icon } from '../lib/ui';

      const status = (id: string) => document.getElementById(id)!;

      // ---- view switching -------------------------------------------------
      function show(view: string) {
        document.querySelectorAll('[data-screen]').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'hidden',
            (el as HTMLElement).dataset.screen !== view,
          );
        });
        // The detail screen belongs to the Library tab.
        const navView = view === 'detail' ? 'library' : view;
        document.querySelectorAll('#nav .nav-item').forEach((el) => {
          const active = (el as HTMLElement).dataset.view === navView;
          (el as HTMLElement).classList.toggle('is-active', active);
          if (active) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
      }

      // ---- rail mode (Agents 11-13) -----------------------------------------
      // data-rail on <html> is the single switch for the compact
      // rail; the pre-paint script set it before first render and
      // this keeps it truthful on resize / toggle. Below 768 the
      // bottom-bar media query owns the layout entirely.
      const railToggle = document.getElementById('rail-toggle');
      function applyRail() {
        const w = window.innerWidth;
        let mode = 'expanded';
        if (w >= 768 && w < 1024) mode = 'compact';
        else if (
          w >= 1024 &&
          localStorage.getItem('lanfetch-rail') === 'compact'
        )
          mode = 'compact';
        document.documentElement.dataset.rail = mode;
        if (railToggle) {
          railToggle.setAttribute(
            'aria-expanded',
            mode === 'expanded' ? 'true' : 'false',
          );
          const label =
            mode === 'expanded' ? 'Collapse sidebar' : 'Expand sidebar';
          railToggle.setAttribute('aria-label', label);
          railToggle.setAttribute('title', label);
        }
      }
      applyRail();
      window.addEventListener('resize', applyRail);
      railToggle?.addEventListener('click', () => {
        const compact = document.documentElement.dataset.rail !== 'compact';
        try {
          localStorage.setItem(
            'lanfetch-rail',
            compact ? 'compact' : 'expanded',
          );
        } catch {}
        applyRail();
      });
      document.querySelectorAll('#nav .nav-item').forEach((el) => {
        el.addEventListener('click', () =>
          show((el as HTMLElement).dataset.view!),
        );
      });
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        if (e.key === '1') show('library');
        else if (e.key === '2') show('transfers');
        else if (e.key === '3') show('servers');
        else if (e.key === ',') show('settings');
        else if (e.key === 'k' || e.key === 'f') {
          e.preventDefault();
          show('library');
          document.getElementById('lib-search')!.focus();
        }
      });
      show('library');

      function renderDownloads(list: DownloadListDto) {
        if (list.stamp > lastStamp) lastStamp = list.stamp;
        const wrap = status('tasks');
        const tasks = list.tasks;
        status('tr-status').textContent =
          tasks.length === 0
            ? 'No transfers yet'
            : tasks.length + ' transfers · ' + list.activeCount + ' active';
        const badge = status('nav-badge');
        if (list.activeCount > 0) {
          badge.textContent = String(list.activeCount);
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
        // The badge numeral is decoration for AT (Agent 31): the
        // count lives in the Transfers button's accessible name.
        document
          .querySelector('#nav .nav-item[data-view="transfers"]')
          ?.setAttribute(
            'aria-label',
            list.activeCount > 0
              ? 'Transfers, ' + list.activeCount + ' active downloads'
              : 'Transfers',
          );
        wrap.replaceChildren();
        if (tasks.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'py-10 text-center text-[13px] text-ink-2';
          empty.textContent =
            'Movies and episodes you download appear here with live progress and speed.';
          wrap.append(empty);
          return;
        }
        for (const t of tasks) {
          const card = document.createElement('div');
          card.className =
            'rounded-2xl border border-hairline bg-surface px-4 py-3.5';
          const top = document.createElement('div');
          top.className = 'flex items-baseline gap-3';
          const name = document.createElement('span');
          name.className = 'min-w-0 flex-1 truncate text-[13.5px] font-medium';
          name.textContent = t.name;
          const state = document.createElement('span');
          state.className = 'text-[12px] font-medium text-ink-2';
          state.textContent =
            STATE_LABEL[t.state] +
            (t.state === 'running' || t.state === 'paused'
              ? ' · ' + Math.round(t.fraction * 100) + '%'
              : '');
          top.append(name, state);
          const bar = document.createElement('div');
          bar.className = 'mt-2.5 h-1.5 overflow-hidden rounded-full bg-raised';
          const fill = document.createElement('div');
          fill.className =
            'h-full rounded-full ' +
            (t.state === 'failed'
              ? 'bg-failed'
              : t.state === 'completed'
                ? 'bg-done'
                : t.state === 'paused'
                  ? 'bg-paused'
                  : 'bg-accent');
          fill.style.width = Math.round(t.fraction * 100) + '%';
          bar.append(fill);
          const meta = document.createElement('p');
          meta.className = 'mt-2 text-[12px] tabular-nums text-ink-3';
          meta.textContent =
            fmtBytes(t.downloaded) +
            (t.total > 0 ? ' of ' + fmtBytes(t.total) : '') +
            (t.state === 'running' && t.speedBps > 0
              ? ' · ' + fmtSpeed(t.speedBps)
              : '') +
            (t.state === 'running' && fmtEta(t.etaSecs)
              ? ' · ' + fmtEta(t.etaSecs)
              : '') +
            (t.error ? ' · ' + t.error : '');
          card.append(top, bar, meta);
          const actions = document.createElement('div');
          actions.className = 'mt-2.5 flex gap-1.5';
          const mkBtn = (label: string, fn: () => Promise<DownloadListDto>) => {
            const b = document.createElement('button');
            b.className =
              'rounded-full border border-hairline px-3 py-1 text-[11.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised';
            b.textContent = label;
            b.addEventListener('click', async () => {
              b.disabled = true;
              try {
                renderDownloads(await fn());
              } catch {
                b.disabled = false;
              }
            });
            return b;
          };
          if (t.state === 'running' || t.state === 'queued') {
            actions.append(mkBtn('Pause', () => pauseDownload(t.id)));
          }
          if (t.state === 'paused') {
            actions.append(mkBtn('Resume', () => resumeDownload(t.id)));
          }
          if (t.state === 'failed') {
            actions.append(mkBtn('Retry', () => resumeDownload(t.id)));
          }
          if (t.state === 'completed' && t.fileMissing) {
            const note = document.createElement('span');
            note.className = 'self-center text-[11.5px] text-paused';
            note.textContent = 'File missing';
            actions.append(
              note,
              mkBtn('Redownload', () => redownloadDownload(t.id)),
            );
          }
          actions.append(mkBtn('Remove', () => removeDownload(t.id)));
          card.append(actions);
          wrap.append(card);
        }
      }

      // ---- live transfers: pushed, never polled --------------------------------
      let lastStamp = 0;
      let dlFetching = false;
      let dlDirty = false;
      async function refreshDownloads(): Promise<void> {
        if (dlFetching) {
          dlDirty = true;
          return;
        }
        dlFetching = true;
        try {
          const list = await getDownloads();
          if (list.stamp >= lastStamp) {
            lastStamp = list.stamp;
            renderDownloads(list);
          }
        } catch {
          // Not in Tauri (browser preview) or a transient IPC error:
          // the next event retries.
        } finally {
          dlFetching = false;
          if (dlDirty) {
            dlDirty = false;
            void refreshDownloads();
          }
        }
      }
      onDownloadsChanged((stamp) => {
        if (stamp > lastStamp) void refreshDownloads();
      });
      document
        .getElementById('tr-clear')!
        .addEventListener('click', async () => {
          try {
            renderDownloads(await clearCompletedDownloads());
          } catch {}
        });
      document
        .getElementById('tr-pause-all')!
        .addEventListener('click', async () => {
          try {
            renderDownloads(await pauseAllDownloads());
          } catch {}
        });
      document
        .getElementById('tr-resume-all')!
        .addEventListener('click', async () => {
          try {
            renderDownloads(await resumeAllDownloads());
          } catch {}
        });

      // ---- servers ----------------------------------------------------------
      let sourcesList: SourceDto[] = [];
      const probeMap = new Map<string, SourceProbeDto>();
      function renderServers(): void {
        const wrap = status('probes');
        wrap.replaceChildren();
        for (const s of sourcesList) {
          const p = probeMap.get(s.name);
          const row = document.createElement('div');
          row.className =
            'flex items-center gap-3 rounded-2xl border border-hairline bg-surface px-4 py-3';
          const dot = document.createElement('span');
          dot.className =
            'h-2 w-2 shrink-0 rounded-full ' + dotClass(p?.status);
          const name = document.createElement('span');
          name.className = 'text-[13.5px] font-medium';
          name.textContent = s.name;
          const url = document.createElement('span');
          url.className = 'min-w-0 flex-1 truncate text-[12px] text-ink-3';
          url.textContent = s.rootUrl;
          const state = document.createElement('span');
          state.className = 'text-[12px] tabular-nums text-ink-2';
          state.textContent = !s.enabled
            ? 'Disabled'
            : p?.status === 'up'
              ? 'Online · ' + p.latencyMs + ' ms'
              : p?.status === 'down'
                ? 'Unreachable'
                : '…';
          const toggle = document.createElement('input');
          toggle.type = 'checkbox';
          toggle.checked = s.enabled;
          toggle.className = 'h-4 w-4 shrink-0 accent-[var(--color-accent)]';
          toggle.title = s.enabled ? 'Disable server' : 'Enable server';
          toggle.addEventListener('change', async () => {
            try {
              sourcesList = await setSourceEnabled(s.name, toggle.checked);
              renderServers();
              void loadProbes();
            } catch {
              toggle.checked = !toggle.checked;
            }
          });
          row.append(dot, name, url, state, toggle);
          if (s.custom) {
            const rm = document.createElement('button');
            rm.className =
              'shrink-0 rounded-full border border-hairline px-2.5 py-1 text-[11.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised';
            rm.textContent = 'Remove';
            rm.addEventListener('click', async () => {
              try {
                sourcesList = await removeSource(s.name);
                probeMap.delete(s.name);
                renderServers();
                void loadProbes();
              } catch (e) {
                status('srv-error').textContent = String(e);
              }
            });
            row.append(rm);
          }
          wrap.append(row);
        }
      }
      async function loadProbes() {
        const results = await probeSources();
        probeMap.clear();
        for (const p of results) probeMap.set(p.name, p);
        renderServers();
        const up = results.filter((r) => r.status === 'up').length;
        status('srv-status').textContent =
          up + ' of ' + results.length + ' servers online';
        status('rail-servers').textContent = up + ' online';
        // Compact rail: server health survives as a dot on the
        // Servers nav item (Agent 12); words live in its label.
        const railDot = document.getElementById('rail-servers-dot');
        if (railDot) {
          railDot.className =
            'rail-dot status-dot' +
            (up > 0 ? ' is-up' : results.length > 0 ? ' is-down' : '');
        }
        document
          .querySelector('#nav .nav-item[data-view="servers"]')
          ?.setAttribute('aria-label', 'Servers, ' + up + ' online');
        if (titleCount === 0 && activeQuery === '') {
          status('lib-status').textContent =
            up > 0
              ? up + ' servers online'
              : 'No servers reachable — check the Servers tab';
        }
      }
      document
        .getElementById('srv-add')!
        .addEventListener('click', async () => {
          const nameEl = document.getElementById('srv-name') as HTMLInputElement;
          const urlEl = document.getElementById('srv-url') as HTMLInputElement;
          status('srv-error').textContent = '';
          try {
            sourcesList = await addSource(nameEl.value, urlEl.value);
            nameEl.value = '';
            urlEl.value = '';
            renderServers();
            void loadProbes();
          } catch (e) {
            status('srv-error').textContent = String(e);
          }
        });

      // ---- theme -------------------------------------------------------------
      function applyTheme(choice: string) {
        localStorage.setItem('lanfetch-theme', choice);
        const dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelectorAll('.theme-btn').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'is-active',
            (el as HTMLElement).dataset.themeChoice === choice,
          );
        });
      }
      document.querySelectorAll('.theme-btn').forEach((el) => {
        el.addEventListener('click', () => {
          const choice = (el as HTMLElement).dataset.themeChoice!;
          applyTheme(choice);
          void persistSettings({ theme: choice });
        });
      });
      applyTheme(localStorage.getItem('lanfetch-theme') ?? 'system');

      // ---- settings ---------------------------------------------------------------
      let currentSettings: SettingsDto | null = null;
      async function persistSettings(
        patch: Partial<SettingsDto>,
      ): Promise<void> {
        if (!currentSettings) return;
        try {
          currentSettings = await updateSettings({
            ...currentSettings,
            ...patch,
          });
        } catch {
          // Browser preview or IPC failure: the local UI state the
          // user just set stays as they left it.
        }
      }
      const sel = (id: string) =>
        document.getElementById(id) as HTMLSelectElement;
      sel('set-connections').addEventListener('change', () =>
        void persistSettings({
          connections: parseInt(sel('set-connections').value, 10),
        }),
      );
      sel('set-concurrent').addEventListener('change', () =>
        void persistSettings({
          maxConcurrent: parseInt(sel('set-concurrent').value, 10),
        }),
      );
      sel('set-language').addEventListener('change', () =>
        void persistSettings({ language: sel('set-language').value }),
      );

      // ---- library feed -------------------------------------------------------
      // The UX laws this implements (the Rune build broke all three):
      // a click takes effect immediately, a newer load supersedes an
      // older one via generation numbers on BOTH sides, and stale
      // results never paint.
      let libGen = 0;
      let feedGen = 0;
      let feedHasMore = false;
      let pageLoading = false;
      let currentCategory: string | null = null;
      let titleCount = 0;

      // ---- library banner + empty states (Agents 16/25) ---------------------
      // Errors are banners with Retry, never gray footnotes in the
      // status line; empty results are calm empty states. The two
      // never substitute for each other.
      let bannerRetry: (() => void) | null = null;
      function showBanner(
        kind: 'error' | 'info',
        msg: string,
        retryLabel: string | null,
        retry: (() => void) | null,
      ): void {
        const banner = status('lib-banner');
        banner.classList.remove('hidden');
        const iconSpan = status('lib-banner-icon');
        iconSpan.className = kind === 'error' ? 'text-failed' : 'text-ink-2';
        iconSpan.replaceChildren(icon(kind === 'error' ? 'warning' : 'info', 20));
        status('lib-banner-text').textContent = msg;
        const btn = status('lib-banner-retry') as HTMLButtonElement;
        bannerRetry = retry;
        if (retry && retryLabel) {
          btn.classList.remove('hidden');
          btn.replaceChildren(icon('retry', 16), document.createTextNode(retryLabel));
        } else {
          btn.classList.add('hidden');
        }
      }
      function hideBanner(): void {
        status('lib-banner').classList.add('hidden');
        bannerRetry = null;
      }
      status('lib-banner-retry').addEventListener('click', () => {
        const retry = bannerRetry;
        hideBanner();
        retry?.();
      });

      let emptyAction: (() => void) | null = null;
      function setEmpty(variant: 'feed' | 'search' | 'favorites'): void {
        const wrap = status('lib-empty');
        wrap.classList.remove('hidden');
        const iconSpan = status('lib-empty-icon');
        const title = status('lib-empty-title');
        const body = status('lib-empty-body');
        const action = status('lib-empty-action') as HTMLButtonElement;
        status('lib-empty-action-2').classList.add('hidden');
        if (variant === 'search') {
          iconSpan.replaceChildren(icon('search', 24));
          title.textContent = 'No results for “' + activeQuery + '”';
          body.textContent =
            'Nothing on the servers matches that title. Check the spelling, or try a shorter search.';
          action.textContent = 'Clear search';
          emptyAction = () => clearSearch();
        } else if (variant === 'favorites') {
          iconSpan.replaceChildren(icon('star', 24));
          title.textContent = 'No favorites yet';
          body.textContent =
            'Open a title and tap the star to keep it here. Favorites are saved on this device.';
          action.textContent = 'Browse library';
          emptyAction = () => {
            currentCategory = null;
            favoritesActive = false;
            void openFeed();
          };
        } else {
          iconSpan.replaceChildren(icon('film', 24));
          title.textContent = 'Nothing here yet';
          body.textContent =
            'No titles in this category right now. If the servers just came online, Refresh reloads the catalog.';
          action.textContent = 'Refresh';
          emptyAction = () => void loadLibrary(true);
        }
      }
      function hideEmpty(): void {
        status('lib-empty').classList.add('hidden');
      }
      status('lib-empty-action').addEventListener('click', () => {
        emptyAction?.();
      });

      function showSkeletons(): void {
        const grid = status('grid');
        grid.replaceChildren();
        grid.setAttribute('aria-busy', 'true');
        for (let i = 0; i < 12; i++) {
          const card = el('div', 'skeleton-card');
          card.setAttribute('aria-hidden', 'true');
          const frame = el('div', 'skeleton skeleton-poster');
          const bar1 = el('div', 'skeleton mt-2 h-3 w-[85%]');
          const bar2 = el('div', 'skeleton mt-1 h-2.5 w-[55%]');
          card.append(frame, bar1, bar2);
          grid.append(card);
        }
      }

      // Poster failures are delegated (Agent 33): one capturing
      // listener instead of one per card. A failed poster reveals
      // the glyph tile underneath — and because failures are not
      // remembered server-side, the next visit can still succeed.
      status('grid').addEventListener(
        'error',
        (e) => {
          if (e.target instanceof HTMLImageElement) e.target.remove();
        },
        true,
      );

      function makeCard(
        t: TitleDto,
        posterSrc: string | null,
        eager = false,
      ): HTMLElement {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'poster-card';
        // The accessible name carries everything the badges show
        // visually (Agent 17): badges themselves are decorative.
        card.setAttribute(
          'aria-label',
          t.title +
            (t.year ? ', ' + t.year : '') +
            (t.kind === 'series'
              ? ', series' +
                (t.seasonCount > 1 ? ', ' + t.seasonCount + ' seasons' : '')
              : t.bestQuality
                ? ', ' + t.bestQuality
                : '') +
            (t.isFavorite ? ', favorited' : ''),
        );
        const frame = el('span', 'poster-frame');
        const fallback = el('span', 'poster-fallback');
        fallback.setAttribute('aria-hidden', 'true');
        const glyph = icon('logo', 32);
        glyph.style.opacity = '0.35';
        fallback.append(glyph);
        frame.append(fallback);
        if (posterSrc) {
          const img = document.createElement('img');
          img.className = 'poster-img';
          img.loading = eager ? 'eager' : 'lazy';
          if (eager) img.setAttribute('fetchpriority', 'high');
          img.decoding = 'async';
          img.draggable = false;
          img.alt = '';
          img.addEventListener('load', () => img.classList.add('is-loaded'));
          img.src = posterSrc;
          if (img.complete && img.naturalWidth > 0)
            img.classList.add('is-loaded');
          frame.append(img);
        }
        const badgeText =
          t.kind === 'series'
            ? t.seasonCount > 1
              ? t.seasonCount + ' Seasons'
              : 'Series'
            : t.bestQuality;
        if (badgeText) {
          const badge = el(
            'span',
            'badge badge-scrim absolute bottom-1.5 left-1.5',
            badgeText,
          );
          badge.setAttribute('aria-hidden', 'true');
          frame.append(badge);
        }
        if (t.isFavorite) {
          const fav = el('span', 'badge badge-scrim absolute right-1.5 top-1.5');
          fav.setAttribute('aria-hidden', 'true');
          fav.append(icon('star-filled', 16));
          frame.append(fav);
        }
        const name = el('span', 'poster-title', t.title);
        const meta = el(
          'span',
          'poster-meta',
          (t.year ? t.year + ' · ' : '') +
            (t.language ? t.language + ' · ' : '') +
            t.sourceName +
            (t.copies > 1 ? ' · ' + t.copies + ' copies' : ''),
        );
        card.append(frame, name, meta);
        card.addEventListener('click', () => void openDetail(t));
        return card;
      }

      /** Paint titles into the grid (poster batch first). Returns
       * false when the generation was superseded mid-paint — the
       * caller then drops everything. */
      async function paintTitles(
        titles: TitleDto[],
        gen: number,
        first: boolean,
      ): Promise<boolean> {
        const grid = status('grid');
        if (first) grid.replaceChildren();
        const withPosters = titles.filter((t) => t.posterUrl);
        const srcByUrl = new Map<string, string>();
        if (withPosters.length > 0) {
          const srcs = await posterSrcs(
            withPosters.map((t) => t.posterUrl!),
          );
          if (gen !== libGen) return false; // superseded while registering
          withPosters.forEach((t, i) => srcByUrl.set(t.posterUrl!, srcs[i]!));
        }
        const frag = document.createDocumentFragment();
        titles.forEach((t, i) => {
          frag.append(
            makeCard(
              t,
              t.posterUrl ? (srcByUrl.get(t.posterUrl) ?? null) : null,
              first && i < 12,
            ),
          );
        });
        grid.append(frag);
        if (first) grid.removeAttribute('aria-busy');
        return true;
      }

      async function appendPage(
        page: FeedPageDto,
        gen: number,
        first: boolean,
      ): Promise<void> {
        feedHasMore = page.hasMore;
        if (!(await paintTitles(page.titles, gen, first))) return;
        titleCount += page.titles.length;
        status('lib-status').textContent =
          titleCount + ' titles' + (feedHasMore ? ' · scroll for more' : '');
        if (first) {
          if (titleCount === 0) setEmpty('feed');
          else hideEmpty();
          hideBanner();
        }
      }

      async function openFeed(): Promise<void> {
        const gen = ++libGen;
        activeQuery = '';
        favoritesActive = false;
        titleCount = 0;
        pageLoading = true;
        paintChips();
        showSkeletons();
        hideEmpty();
        syncSearchChrome();
        status('lib-status').textContent = 'Loading…';
        try {
          const page = await feedOpen(currentCategory);
          if (gen !== libGen || page.superseded) return;
          feedGen = page.generation;
          await appendPage(page, gen, true);
        } catch {
          if (gen === libGen) {
            status('grid').replaceChildren();
            status('grid').removeAttribute('aria-busy');
            showBanner(
              'error',
              'Could not load the catalog — are the servers reachable?',
              'Retry',
              () => void openFeed(),
            );
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      async function loadMore(): Promise<void> {
        if (pageLoading || !feedHasMore) return;
        pageLoading = true;
        const gen = libGen;
        try {
          const page = await feedNext(feedGen);
          if (gen !== libGen || page.superseded) return;
          await appendPage(page, gen, false);
        } catch {
          // A failed page is not fatal: the sentinel will retry on
          // the next scroll pass.
        } finally {
          pageLoading = false;
        }
      }

      let favoritesActive = false;
      async function openFavorites(): Promise<void> {
        const gen = ++libGen;
        favoritesActive = true;
        activeQuery = '';
        feedHasMore = false;
        titleCount = 0;
        pageLoading = true;
        paintChips();
        showSkeletons();
        hideEmpty();
        syncSearchChrome();
        status('lib-status').textContent = 'Loading favorites…';
        try {
          const favs = await getFavorites();
          if (gen !== libGen) return;
          if (!(await paintTitles(favs, gen, true))) return;
          titleCount = favs.length;
          status('lib-status').textContent = favs.length + ' favorites';
          if (favs.length === 0) setEmpty('favorites');
          else hideEmpty();
          hideBanner();
        } catch {
          if (gen === libGen) {
            status('grid').removeAttribute('aria-busy');
            showBanner('error', 'Could not load favorites.', 'Retry', () =>
              void openFavorites(),
            );
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      // Chip state is derived, never toggled ad hoc (Agent 18):
      // paintChips() re-derives is-active / aria-pressed / roving
      // tabindex from (activeQuery, favoritesActive, currentCategory)
      // — including after a search, which selects no chip. That is
      // the fix for the old bug where searching from Favorites left
      // the Favorites chip highlighted.
      function paintChips(scroll = false): void {
        const wrap = status('chips');
        let roving: HTMLElement | null = null;
        let fallback: HTMLElement | null = null;
        wrap.querySelectorAll('.chip').forEach((el) => {
          const b = el as HTMLElement;
          const kind = b.dataset.chipKind;
          const active =
            activeQuery !== ''
              ? false
              : kind === 'fav'
                ? favoritesActive
                : kind === 'cat' &&
                  !favoritesActive &&
                  (b.dataset.chipValue ?? '') === (currentCategory ?? '');
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
          if (active) roving = b;
          if (
            kind === 'cat' &&
            (b.dataset.chipValue ?? '') === (currentCategory ?? '')
          )
            fallback = b;
        });
        const target = roving ?? fallback ?? wrap.querySelector('.chip');
        wrap.querySelectorAll('.chip').forEach((el) => {
          (el as HTMLElement).tabIndex = el === target ? 0 : -1;
        });
        const favIcon = wrap.querySelector('.fav-chip-icon');
        if (favIcon)
          favIcon.replaceChildren(
            icon(favoritesActive ? 'star-filled' : 'star', 16),
          );
        if (scroll && target)
          (target as HTMLElement).scrollIntoView({
            block: 'nearest',
            inline: 'nearest',
          });
      }

      function renderChips(categories: CategoryDto[]): void {
        const wrap = status('chips');
        wrap.replaceChildren();
        const mk = (
          label: string,
          value: string | null,
          sources?: string[],
        ) => {
          const b = document.createElement('button');
          b.className = 'chip';
          b.dataset.chipKind = 'cat';
          b.dataset.chipValue = value ?? '';
          b.textContent = label;
          if (sources && sources.length > 0)
            b.title = 'On: ' + sources.join(', ');
          b.addEventListener('click', () => {
            if (currentCategory === value && !favoritesActive) return;
            currentCategory = value;
            favoritesActive = false;
            void openFeed();
          });
          return b;
        };
        wrap.append(mk('All', null));
        const favChip = document.createElement('button');
        favChip.className = 'chip';
        favChip.dataset.chipKind = 'fav';
        const favIcon = el('span', 'fav-chip-icon');
        favIcon.setAttribute('aria-hidden', 'true');
        favChip.append(favIcon, document.createTextNode('Favorites'));
        favChip.addEventListener('click', () => {
          if (favoritesActive) return;
          void openFavorites();
        });
        wrap.append(favChip);
        for (const c of categories) wrap.append(mk(c.name, c.name, c.sources));
        // Roving tabindex (Agent 18): arrows move focus only,
        // Enter/Space activate via the native click.
        wrap.onkeydown = (e) => {
          const chips = [...wrap.querySelectorAll('.chip')] as HTMLElement[];
          const i = chips.indexOf(document.activeElement as HTMLElement);
          if (i < 0) return;
          let j: number | null = null;
          if (e.key === 'ArrowRight') j = (i + 1) % chips.length;
          else if (e.key === 'ArrowLeft')
            j = (i - 1 + chips.length) % chips.length;
          else if (e.key === 'Home') j = 0;
          else if (e.key === 'End') j = chips.length - 1;
          if (j !== null) {
            e.preventDefault();
            chips.forEach((c, k) => (c.tabIndex = k === j ? 0 : -1));
            chips[j]!.focus();
          }
        };
        paintChips();
      }

      async function loadLibrary(refresh: boolean): Promise<void> {
        try {
          const categories = await getCategories(refresh);
          if (categories.length === 0) {
            status('lib-status').textContent =
              'No categories found — check the Servers tab';
            return;
          }
          hideBanner();
          renderChips(categories);
          void openFeed();
        } catch {
          showBanner(
            'error',
            'Could not load categories — are the servers reachable?',
            'Retry',
            () => void loadLibrary(true),
          );
        }
      }

      document
        .getElementById('lib-refresh')!
        .addEventListener('click', async () => {
          const btn = status('lib-refresh') as HTMLButtonElement;
          btn.disabled = true;
          btn.classList.add('is-busy');
          btn.setAttribute('aria-busy', 'true');
          try {
            await loadLibrary(true);
          } finally {
            btn.disabled = false;
            btn.classList.remove('is-busy');
            btn.removeAttribute('aria-busy');
          }
        });

      new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) void loadMore();
        },
        { rootMargin: '600px' },
      ).observe(status('sentinel'));

      // ---- search ---------------------------------------------------------------
      // Search and the feed share one generation counter: whichever
      // starts last owns the grid, and the loser's results are
      // dropped even if they arrive later.
      let searchTimer: number | undefined;
      let activeQuery = '';
      async function runSearch(q: string): Promise<void> {
        const gen = ++libGen;
        activeQuery = q;
        favoritesActive = false;
        feedHasMore = false;
        titleCount = 0;
        pageLoading = true;
        paintChips();
        showSkeletons();
        hideEmpty();
        status('lib-status').textContent = 'Searching…';
        try {
          const results = await searchTitles(q);
          if (gen !== libGen) return;
          if (!(await paintTitles(results, gen, true))) return;
          titleCount = results.length;
          status('lib-status').textContent =
            results.length + ' results for “' + q + '”';
          if (results.length === 0) setEmpty('search');
          else hideEmpty();
          hideBanner();
        } catch {
          if (gen === libGen) {
            status('grid').removeAttribute('aria-busy');
            showBanner(
              'error',
              'Search failed — are the servers reachable?',
              'Retry',
              () => void runSearch(q),
            );
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }
      const searchInput = document.getElementById(
        'lib-search',
      ) as HTMLInputElement;
      // Clear button + Ctrl-K hint visibility follows the field.
      function syncSearchChrome(): void {
        const hasText = searchInput.value.length > 0;
        status('lib-clear').classList.toggle('hidden', !hasText);
        document
          .querySelector('.search-hint')
          ?.classList.toggle('hidden', hasText);
      }
      function clearSearch(): void {
        window.clearTimeout(searchTimer);
        searchInput.value = '';
        syncSearchChrome();
        if (activeQuery !== '') void openFeed();
      }
      status('lib-clear').addEventListener('click', () => {
        clearSearch();
        searchInput.focus();
      });
      searchInput.addEventListener('input', () => {
        syncSearchChrome();
        const q = searchInput.value.trim();
        window.clearTimeout(searchTimer);
        if (q.length === 0) {
          if (activeQuery !== '') void openFeed();
          return;
        }
        searchTimer = window.setTimeout(() => void runSearch(q), 300);
      });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const q = searchInput.value.trim();
          window.clearTimeout(searchTimer);
          if (q) void runSearch(q);
        } else if (e.key === 'Escape') {
          clearSearch();
        }
      });

      // ---- title detail ---------------------------------------------------------
      let detailGen = 0;
      let detailTitle: TitleDto | null = null;

      function fileButton(f: FileDto): HTMLButtonElement {
        const b = document.createElement('button');
        b.className =
          'shrink-0 rounded-full bg-accent px-3.5 py-1.5 text-[12px] font-semibold text-white transition-opacity duration-150 disabled:opacity-60';
        const label = () => {
          switch (f.downloadState) {
            case 'queued':
              b.textContent = 'Queued';
              b.disabled = true;
              break;
            case 'running':
              b.textContent =
                'Downloading ' +
                Math.round((f.downloadFraction ?? 0) * 100) +
                '%';
              b.disabled = true;
              break;
            case 'paused':
              b.textContent = 'Paused';
              b.disabled = true;
              break;
            case 'completed':
              b.textContent = 'Downloaded';
              b.disabled = true;
              break;
            case 'failed':
              b.textContent = 'Retry';
              b.disabled = false;
              break;
            default:
              b.textContent = 'Download';
              b.disabled = false;
          }
        };
        label();
        b.addEventListener('click', async () => {
          b.disabled = true;
          b.textContent = 'Queueing…';
          try {
            const list = await startDownload(f.fileUrl, f.fileName);
            renderDownloads(list);
            f.downloadState = 'queued';
            label();
          } catch {
            b.textContent = 'Download';
            b.disabled = false;
          }
        });
        return b;
      }

      function renderFiles(detail: TitleDetailDto): void {
        const wrap = status('detail-files');
        wrap.replaceChildren();
        if (detail.files.length === 0) {
          const p = document.createElement('p');
          p.className = 'text-[13px] text-ink-2';
          p.textContent = 'No downloadable files in this folder.';
          wrap.append(p);
          return;
        }
        const isSeries = detail.title.kind === 'series';
        const seasons = new Map<number, FileDto[]>();
        for (const f of detail.files) {
          const key = isSeries ? (f.season ?? 0) : 0;
          const arr = seasons.get(key) ?? [];
          arr.push(f);
          seasons.set(key, arr);
        }
        for (const season of [...seasons.keys()].sort((a, b) => a - b)) {
          if (isSeries) {
            const h = document.createElement('p');
            h.className =
              'mt-2 text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3';
            h.textContent = season > 0 ? 'Season ' + season : 'Episodes';
            wrap.append(h);
          }
          for (const f of seasons.get(season)!) {
            const row = document.createElement('div');
            row.className =
              'flex items-center gap-3 rounded-xl border border-hairline bg-surface px-3.5 py-2.5';
            const text = document.createElement('div');
            text.className = 'min-w-0 flex-1';
            const name = document.createElement('p');
            name.className = 'truncate text-[13px] font-medium';
            name.textContent = f.fileName;
            const sub = document.createElement('p');
            sub.className = 'mt-0.5 text-[11.5px] tabular-nums text-ink-3';
            sub.textContent =
              (f.episode != null ? 'E' + f.episode + ' · ' : '') +
              (f.size >= 0 ? fmtBytes(f.size) : 'Size unknown') +
              (f.quality ? ' · ' + f.quality : '') +
              (f.codec ? ' · ' + f.codec : '') +
              (f.audio ? ' · ' + f.audio : '');
            text.append(name, sub);
            row.append(text, fileButton(f));
            wrap.append(row);
          }
        }
      }

      async function openDetail(t: TitleDto): Promise<void> {
        const gen = ++detailGen;
        detailTitle = t;
        show('detail');
        // Snapshot paint: everything the DTO already knows renders
        // now; only the file list waits for hydration.
        status('detail-title').textContent = t.title;
        status('detail-meta').textContent =
          (t.year ? t.year + ' · ' : '') +
          t.category +
          ' · ' +
          t.sourceName +
          (t.language ? ' · ' + t.language : '') +
          (t.copies > 1 ? ' · ' + t.copies + ' copies' : '');
        status('detail-initials').textContent = initials(t.title);
        const poster = status('detail-poster') as HTMLImageElement;
        poster.classList.add('hidden');
        poster.removeAttribute('src');
        if (t.posterUrl) {
          const [src] = await posterSrcs([t.posterUrl]);
          if (gen === detailGen && src) {
            poster.src = src;
            poster.classList.remove('hidden');
            poster.addEventListener('error', () => poster.classList.add('hidden'), {
              once: true,
            });
          }
        }
        const fav = status('detail-fav');
        fav.textContent = t.isFavorite ? '★ Favorited' : '☆ Favorite';
        status('detail-status').textContent = 'Loading files…';
        status('detail-files').replaceChildren();
        try {
          const detail = await getTitleDetail(t.folderUrl);
          if (gen !== detailGen) return;
          detailTitle = detail.title;
          status('detail-status').textContent =
            detail.files.length + ' files · click Download to start';
          renderFiles(detail);
        } catch {
          if (gen === detailGen) {
            status('detail-status').textContent =
              'Could not load the file list — the server may be unreachable.';
          }
        }
      }

      document
        .getElementById('detail-back')!
        .addEventListener('click', () => show('library'));
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const detail = document.querySelector('[data-screen="detail"]')!;
        if (!detail.classList.contains('hidden')) show('library');
      });
      status('detail-fav').addEventListener('click', async () => {
        if (!detailTitle) return;
        const now = await toggleFavorite(detailTitle.folderUrl);
        detailTitle.isFavorite = now;
        status('detail-fav').textContent = now ? '★ Favorited' : '☆ Favorite';
      });

      // ---- boot ---------------------------------------------------------------
      async function main() {
        let boot: BootstrapDto;
        try {
          boot = await getBootstrap();
        } catch {
          // No backend answered: a static preview, an unreachable
          // web server, or a failed IPC bridge (Agent 30). Say that
          // honestly and offer a real retry — a reload re-runs boot
          // cleanly in both transports.
          showBanner(
            'info',
            'Could not reach the LanFetch backend. If this is a preview, start the desktop app or the web server, then retry.',
            'Retry',
            () => location.reload(),
          );
          return;
        }
        status('version').textContent = 'v' + boot.appVersion;
        status('set-dl-dir').textContent = boot.downloadsDir;
        status('set-data-dir').textContent = boot.dataDir;
        currentSettings = boot.settings;
        sourcesList = boot.sources;
        renderServers();
        sel('set-connections').value = String(boot.settings.connections);
        sel('set-concurrent').value = String(boot.settings.maxConcurrent);
        sel('set-language').value = boot.settings.language;
        // settings.json is the theme's source of truth; localStorage
        // is only the pre-paint cache that mirrors it.
        applyTheme(boot.settings.theme);
        if (!boot.settings.onboardingDone) {
          status('onboarding').classList.remove('hidden');
          const finishOnboarding = async () => {
            status('onboarding').classList.add('hidden');
            await persistSettings({ onboardingDone: true });
          };
          document
            .getElementById('ob-done')!
            .addEventListener('click', () => void finishOnboarding());
          document
            .getElementById('ob-check')!
            .addEventListener('click', () => {
              void finishOnboarding();
              show('servers');
            });
        }
        renderDownloads(boot.downloads);
        void loadProbes();
        void loadLibrary(false);
        void checkUpdate().then((v) => {
          status('set-update').textContent = v
            ? 'LanFetch ' +
              v +
              ' is available — download it from the project’s Releases page. Your settings and downloads carry over.'
            : 'You are on the latest version.';
        });
      }
      void main();
    </script>
  </body>
</html>
