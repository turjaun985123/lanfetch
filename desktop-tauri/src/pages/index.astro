---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>LanFetch</title>
    {/* The two is:inline scripts below are allow-listed in both
        CSP copies (web/src/serve.rs WEB_CSP and
        src-tauri/tauri.conf.json) by their sha256 hashes. Editing
        either script changes its hash and CSP-strict browsers
        will block it again — recompute both hashes and update
        both CSPs in the same commit. */}
    <script is:inline>
      // Theme before first paint (no flash): stored choice wins,
      // otherwise follow the OS.
      try {
        var t = localStorage.getItem('lanfetch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script is:inline>
      // Rail mode before first paint (Agents 12/13): compact in the
      // 768-1023 band, or at >=1024 when the user collapsed it
      // (localStorage 'lanfetch-rail'). Below 768 the rail becomes
      // the bottom bar and this attribute is irrelevant.
      try {
        var w = window.innerWidth;
        var rail = 'expanded';
        if (w >= 768 && w < 1024) rail = 'compact';
        else if (w >= 1024 && localStorage.getItem('lanfetch-rail') === 'compact')
          rail = 'compact';
        document.documentElement.dataset.rail = rail;
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Icon sprite (DESIGN.md / Agent 10): one definition per
         glyph, referenced by <use href="#i-…"> everywhere, static
         and JS-rendered alike. Lucide-style: 24 grid, stroke 2,
         round caps, currentColor. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-logo" viewBox="0 0 32 32">
          <rect width="32" height="32" rx="8" style="fill:var(--accent)"/>
          <g fill="none" style="stroke:var(--on-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 6.5v11"/>
            <path d="m10.5 13 5.5 5.5L21.5 13"/>
            <path d="M9 24.5h14"/>
          </g>
        </symbol>
        <symbol id="i-library" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="4" width="4.5" height="16" rx="1"/>
            <rect x="9.75" y="4" width="4.5" height="16" rx="1"/>
            <path d="M17.6 5.4 21 4.4l2.1 13.2-3.4 1z"/>
          </g>
        </symbol>
        <symbol id="i-transfers" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v11"/>
            <path d="m7 9.5 5 5 5-5"/>
            <path d="M4 21h16"/>
          </g>
        </symbol>
        <symbol id="i-servers" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="7" rx="2"/>
            <rect x="3" y="13" width="18" height="7" rx="2"/>
            <circle cx="7.5" cy="7.5" r="0.6" fill="currentColor" stroke="none"/>
            <circle cx="7.5" cy="16.5" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-settings" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h9M19 6h1"/>
            <circle cx="16" cy="6" r="2"/>
            <path d="M4 12h3M13 12h7"/>
            <circle cx="10" cy="12" r="2"/>
            <path d="M4 18h11M19 18h1"/>
            <circle cx="17" cy="18" r="2"/>
          </g>
        </symbol>
        <symbol id="i-search" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m16.5 16.5 4.5 4.5"/>
          </g>
        </symbol>
        <symbol id="i-refresh" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-2.64-6.36"/>
            <path d="M21 3v6h-6"/>
          </g>
        </symbol>
        <symbol id="i-retry" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 2.64-6.36"/>
            <path d="M3 3v6h6"/>
          </g>
        </symbol>
        <symbol id="i-back" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12H4"/>
            <path d="m11 5-7 7 7 7"/>
          </g>
        </symbol>
        <symbol id="i-close" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 5l14 14M19 5L5 19"/>
          </g>
        </symbol>
        <symbol id="i-check" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12.5 9.5 18 20 6.5"/>
          </g>
        </symbol>
        <symbol id="i-warning" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.3 4.1 2.9 17a2 2 0 0 0 1.7 3h14.8a2 2 0 0 0 1.7-3L13.7 4.1a2 2 0 0 0-3.4 0Z"/>
            <path d="M12 9v4"/>
            <circle cx="12" cy="16.5" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-info" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 11v5"/>
            <circle cx="12" cy="8" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-download" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12"/>
            <path d="m7 10.5 5 5 5-5"/>
            <path d="M3 15v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4"/>
          </g>
        </symbol>
        <symbol id="i-pause" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="4" width="4" height="16" rx="1"/>
            <rect x="14" y="4" width="4" height="16" rx="1"/>
          </g>
        </symbol>
        <symbol id="i-play" viewBox="0 0 24 24">
          <path d="M8 5.4v13.2a1 1 0 0 0 1.52.86l11-6.6a1 1 0 0 0 0-1.72l-11-6.6A1 1 0 0 0 8 5.4Z" fill="currentColor"/>
        </symbol>
        <symbol id="i-trash" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h16"/>
            <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            <path d="M6.5 7l.9 12.2A2 2 0 0 0 9.4 21h5.2a2 2 0 0 0 2-1.8L17.5 7"/>
            <path d="M10 11v6M14 11v6"/>
          </g>
        </symbol>
        <symbol id="i-redownload" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 2.64-6.36"/>
            <path d="M3 3v6h6"/>
            <path d="M8 21h8"/>
          </g>
        </symbol>
        <symbol id="i-star" viewBox="0 0 24 24">
          <path d="M12 3.6l2.9 5.8 6.3.9-4.6 4.3 1.2 6.4L12 17.8 6.2 21l1.2-6.4L2.8 10.3l6.3-.9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </symbol>
        <symbol id="i-star-filled" viewBox="0 0 24 24">
          <path d="M12 3.6l2.9 5.8 6.3.9-4.6 4.3 1.2 6.4L12 17.8 6.2 21l1.2-6.4L2.8 10.3l6.3-.9z" fill="currentColor"/>
        </symbol>
        <symbol id="i-plus" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </g>
        </symbol>
        <symbol id="i-chevron-down" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </g>
        </symbol>
        <symbol id="i-panel-left" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <path d="M9.5 4v16"/>
          </g>
        </symbol>
        <symbol id="i-film" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <path d="M8 4v16M16 4v16M3 9h5M3 15h5M16 9h5M16 15h5"/>
          </g>
        </symbol>
        <symbol id="i-sun" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </g>
        </symbol>
        <symbol id="i-moon" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 13.6A8.5 8.5 0 1 1 10.4 4 6.8 6.8 0 0 0 20 13.6Z"/>
          </g>
        </symbol>
        <symbol id="i-monitor" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="12" rx="2"/>
            <path d="M9 20h6M12 16v4"/>
          </g>
        </symbol>
        <symbol id="i-globe" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18"/>
            <path d="M12 3a13.8 13.8 0 0 1 0 18 13.8 13.8 0 0 1 0-18Z"/>
          </g>
        </symbol>
        <symbol id="i-hard-drive" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12H2"/>
            <path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1Z"/>
            <circle cx="12" cy="16" r="0.6" fill="currentColor" stroke="none"/>
          </g>
        </symbol>
        <symbol id="i-arrow-up-circle" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 16V8"/>
            <path d="m8.5 11.5 3.5-3.5 3.5 3.5"/>
          </g>
        </symbol>
        <symbol id="i-clock" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3 2"/>
          </g>
        </symbol>
        <symbol id="i-copy" viewBox="0 0 24 24">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="12" height="12" rx="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </g>
        </symbol>
      </defs>
    </svg>
    <div class="flex h-full">
      <!-- Rail: ONE nav element for every band (Agents 11-13).
           >=1024 expanded or user-collapsed, 768-1023 forced
           compact, <768 the same element becomes the bottom bar —
           so show(), the badge and the shortcuts can never desync. -->
      <aside id="rail" class="rail flex shrink-0 bg-surface">
        <div class="brand-row">
          <svg class="ic ic-24 brand-glyph" aria-hidden="true"><use href="#i-logo" /></svg>
          <span class="nav-label text-page font-semibold">lanfetch</span>
          <button
            id="rail-toggle"
            class="icon-btn ml-auto"
            type="button"
            aria-expanded="true"
            aria-controls="nav"
            aria-label="Collapse sidebar"
            title="Collapse sidebar"
          >
            <svg class="ic" aria-hidden="true"><use href="#i-panel-left" /></svg>
          </button>
        </div>
        <nav class="flex gap-1" id="nav" aria-label="Primary">
          <button data-view="library" class="nav-item" aria-label="Library" title="Library">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-library" /></svg>
            <span class="nav-label">Library</span>
          </button>
          <button data-view="transfers" class="nav-item" aria-label="Transfers" title="Transfers">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-transfers" /></svg>
            <span class="nav-label">Transfers</span>
            <span id="nav-badge" class="badge-count hidden" aria-hidden="true"></span>
          </button>
          <button data-view="servers" class="nav-item" aria-label="Servers" title="Servers">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-servers" /></svg>
            <span class="nav-label">Servers</span>
            <span id="rail-servers-dot" class="rail-dot status-dot" aria-hidden="true"></span>
          </button>
          <button data-view="settings" class="nav-item" aria-label="Settings" title="Settings">
            <svg class="ic ic-20" aria-hidden="true"><use href="#i-settings" /></svg>
            <span class="nav-label">Settings</span>
          </button>
        </nav>
        <div class="rail-meta section-label mt-auto px-4 pb-1">Servers</div>
        <div class="rail-meta px-4 pb-2 text-secondary text-ink-2" id="rail-servers">…</div>
        <div class="rail-meta border-t border-hairline px-4 py-3 text-caption text-ink-3" id="version"></div>
      </aside>

      <!-- Content -->
      <main class="min-w-0 flex-1 overflow-y-auto">
        <!-- Library -->
        <section data-screen="library">
          <header class="screen-header">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="page-title" tabindex="-1">Library</h1>
              <div class="search-wrap relative min-w-0 flex-1 max-[767px]:order-3 max-[767px]:w-full max-[767px]:flex-none md:ml-auto md:max-w-[420px]">
                <svg class="ic ic-16 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" aria-hidden="true"><use href="#i-search" /></svg>
                <label class="sr-only" for="lib-search">Search titles</label>
                <input
                  id="lib-search"
                  type="search"
                  placeholder="Search titles…"
                  autocomplete="off"
                  class="w-full rounded-full border border-border-strong bg-surface py-1.5 pl-9 pr-16 text-control text-ink outline-none placeholder:text-ink-3 focus:border-accent"
                />
                <button
                  id="lib-clear"
                  type="button"
                  class="icon-btn absolute right-1 top-1/2 hidden h-7 w-7 -translate-y-1/2"
                  aria-label="Clear search"
                >
                  <svg class="ic ic-16" aria-hidden="true"><use href="#i-close" /></svg>
                </button>
                <kbd class="search-hint pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded-sm border border-hairline bg-raised px-1.5 py-0.5 text-caption text-ink-3">Ctrl K</kbd>
              </div>
              <button
                id="lib-refresh"
                class="icon-btn max-[767px]:order-2 max-[767px]:ml-auto"
                aria-label="Refresh catalog"
                title="Refresh catalog"
              >
                <svg class="ic" aria-hidden="true"><use href="#i-refresh" /></svg>
              </button>
            </div>
            <p class="status-line" id="lib-status" role="status" aria-live="polite">…</p>
            <div
              id="chips"
              class="mt-3 flex gap-2 overflow-x-auto pb-1"
              role="group"
              aria-label="Categories"
            ></div>
            <div
              id="lib-filters"
              class="mt-2 flex flex-wrap items-center gap-2"
              role="group"
              aria-label="Filter titles"
            >
              <div id="lib-filter-kind"></div>
              <div id="lib-filter-quality"></div>
              <div id="lib-filter-language"></div>
              <div id="lib-filter-source"></div>
              <div id="lib-filter-tag"></div>
              <div id="lib-filter-year-from"></div>
              <div id="lib-filter-year-to"></div>
              <div id="lib-filter-size"></div>
              <button
                id="lib-filter-dual"
                class="chip"
                aria-pressed="false"
                title="Only titles with dual audio"
              >
                Dual audio
              </button>
              <div id="lib-filter-sort"></div>
              <button id="lib-filter-clear" class="btn btn-ghost btn-sm hidden">
                Clear filters
              </button>
            </div>
          </header>
          <div class="px-6 max-[767px]:px-4">
            <div id="lib-banner" class="banner mt-4 hidden" role="alert">
              <span id="lib-banner-icon" class="text-failed"></span>
              <p id="lib-banner-text" class="min-w-0 flex-1 text-body"></p>
              <button id="lib-banner-retry" class="btn btn-ghost btn-sm shrink-0"></button>
              <button id="lib-banner-close" class="icon-btn shrink-0" aria-label="Dismiss">
                <svg class="ic ic-16" aria-hidden="true"><use href="#i-close" /></svg>
              </button>
            </div>
          </div>
          <div id="onboarding" class="hidden px-6 pt-5 max-[767px]:px-4">
            <div class="card px-5 py-4">
              <p class="text-page font-semibold">Welcome to LanFetch</p>
              <p class="mt-1 max-w-[560px] text-body leading-relaxed text-ink-2">
                Your DhakaFlix servers are already set up — no configuration
                needed. Browse the Library, open a title, and download with
                byte-exact resume: pause anything, close the app, and it
                continues where it left off.
              </p>
              <ul class="mt-3 flex flex-col gap-1.5 text-body text-ink-2">
                <li class="flex items-center gap-2">
                  <svg class="ic ic-16 text-done" aria-hidden="true"><use href="#i-check" /></svg>
                  Byte-exact resume — pause anything, continue where it left off
                </li>
                <li class="flex items-center gap-2">
                  <svg class="ic ic-16 text-done" aria-hidden="true"><use href="#i-download" /></svg>
                  Parallel segments for the fastest speed your network allows
                </li>
                <li class="flex items-center gap-2">
                  <svg class="ic ic-16 text-done" aria-hidden="true"><use href="#i-servers" /></svg>
                  Works out of the box — no configuration needed
                </li>
              </ul>
              <div class="mt-4 flex gap-2">
                <button id="ob-done" class="btn btn-primary btn-sm">
                  Start browsing
                </button>
                <button id="ob-check" class="btn btn-ghost btn-sm">
                  Check servers first
                </button>
              </div>
            </div>
          </div>
          <div
            id="grid"
            class="poster-grid"
            role="group"
            aria-label="Titles"
          ></div>
          <div id="lib-empty" class="empty-state hidden">
            <div role="status" class="flex flex-col items-center">
              <span id="lib-empty-icon" class="text-ink-3"></span>
              <h3 id="lib-empty-title" class="mt-3 text-heading font-semibold"></h3>
              <p id="lib-empty-body" class="mt-1 max-w-[420px] text-body text-ink-2"></p>
            </div>
            <div class="mt-4 flex gap-2">
              <button id="lib-empty-action" class="btn btn-primary btn-sm"></button>
            </div>
          </div>
          <div id="sentinel" class="h-2"></div>
        </section>

        <!-- Detail -->
        <section data-screen="detail" class="hidden">
          <div class="hero">
            <img
              id="detail-wash"
              class="hero-wash hidden"
              alt=""
              aria-hidden="true"
              draggable="false"
            />
            <div class="hero-scrim"></div>
            <div class="relative">
              <header class="flex items-center justify-between px-6 pt-4 max-[767px]:px-4">
                <button id="detail-back" class="btn btn-ghost btn-sm">
                  <svg class="ic ic-16" aria-hidden="true"><use href="#i-back" /></svg>
                  Library
                </button>
                <button
                  id="detail-fav"
                  class="btn btn-ghost btn-sm"
                  aria-pressed="false"
                >
                  <span id="detail-fav-icon"></span>
                  <span id="detail-fav-label">Favorite</span>
                </button>
              </header>
              <div class="flex gap-5 px-6 pb-6 pt-4 max-[639px]:flex-col max-[639px]:gap-4 max-[767px]:px-4 min-[640px]:gap-6">
                <div class="w-[128px] shrink-0 min-[640px]:w-[160px] min-[1024px]:w-[180px] min-[1280px]:w-[200px]">
                  <div class="detail-poster-frame">
                    <div
                      id="detail-initials"
                      class="absolute inset-0 flex items-center justify-center text-display font-semibold text-ink-3"
                    ></div>
                    <img
                      id="detail-poster"
                      class="absolute inset-0 hidden h-full w-full object-cover"
                      draggable="false"
                      alt=""
                    />
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <h2
                    id="detail-title"
                    tabindex="-1"
                    class="text-display font-semibold leading-tight max-[639px]:text-page"
                  ></h2>
                  <div id="detail-meta" class="mt-2.5 flex flex-wrap gap-1.5"></div>
                  <p id="detail-status" class="status-line mt-2"></p>
                </div>
              </div>
            </div>
          </div>
          <div class="mx-auto w-full max-w-[1600px] px-6 py-5 max-[767px]:px-4">
            <h3 id="detail-files-heading" class="text-heading font-semibold">Files</h3>
            <div id="detail-files" class="mt-3 flex flex-col gap-2"></div>
          </div>
        </section>

        <!-- Transfers -->
        <section data-screen="transfers" class="hidden">
          <header class="screen-header">
            <div class="flex flex-wrap items-center justify-between gap-2">
