---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LanFetch</title>
    <script is:inline>
      // Theme before first paint (no flash): stored choice wins,
      // otherwise follow the OS.
      try {
        var t = localStorage.getItem('lanfetch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="flex h-full">
      <!-- Rail -->
      <aside
        class="flex w-52 shrink-0 flex-col border-r border-hairline bg-surface"
      >
        <div class="px-4 pb-2 pt-4 text-[22px] font-semibold tracking-tight">
          lanfetch
        </div>
        <nav
          class="flex flex-col gap-1 px-3 py-2 text-[13px] font-medium"
          id="nav"
        >
          <button data-view="library" class="nav-item">Library</button>
          <button data-view="transfers" class="nav-item">
            Transfers
            <span
              id="nav-badge"
              class="ml-auto hidden min-w-[18px] rounded-full bg-accent px-1 text-center text-[10px] font-semibold text-white"
            ></span>
          </button>
          <button data-view="servers" class="nav-item">Servers</button>
          <button data-view="settings" class="nav-item">Settings</button>
        </nav>
        <div class="mt-auto px-4 pb-1 text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">
          Servers
        </div>
        <div class="px-4 pb-2 text-[12px] text-ink-2" id="rail-servers">…</div>
        <div class="px-4 py-3 text-[11px] text-ink-3" id="version"></div>
      </aside>

      <!-- Content -->
      <main class="min-w-0 flex-1 overflow-y-auto">
        <!-- Library -->
        <section data-screen="library">
          <header class="border-b border-hairline px-6 py-3">
            <div class="flex items-center justify-between">
              <h1 class="text-[17px] font-semibold">Library</h1>
              <button
                id="lib-refresh"
                class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
              >
                Refresh
              </button>
            </div>
            <p class="text-[12px] text-ink-2" id="lib-status">…</p>
            <div
              id="chips"
              class="mt-3 flex gap-1.5 overflow-x-auto pb-1"
            ></div>
          </header>
          <div
            id="grid"
            class="grid grid-cols-[repeat(auto-fill,minmax(132px,1fr))] gap-x-4 gap-y-5 px-6 py-5"
          ></div>
          <div id="lib-empty" class="hidden px-6 py-16 text-center">
            <p class="text-[15px] font-semibold">Nothing here yet</p>
            <p class="mx-auto mt-1.5 max-w-[420px] text-[12px] leading-relaxed text-ink-2">
              No titles in this category right now. If the servers just
              came online, Refresh reloads the catalog.
            </p>
          </div>
          <div id="sentinel" class="h-2"></div>
        </section>

        <!-- Transfers -->
        <section data-screen="transfers" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <h1 class="text-[17px] font-semibold">Transfers</h1>
            <p class="text-[12px] text-ink-2" id="tr-status">…</p>
          </header>
          <div class="flex flex-col gap-2.5 px-6 py-5" id="tasks"></div>
        </section>

        <!-- Servers -->
        <section data-screen="servers" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <h1 class="text-[17px] font-semibold">Servers</h1>
            <p class="text-[12px] text-ink-2" id="srv-status">…</p>
          </header>
          <div class="flex flex-col gap-2 px-6 py-5" id="probes"></div>
        </section>

        <!-- Settings -->
        <section data-screen="settings" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <h1 class="text-[17px] font-semibold">Settings</h1>
            <p class="text-[12px] text-ink-2">Applies immediately — no Save button.</p>
          </header>
          <div class="flex max-w-[560px] flex-col gap-6 px-6 py-5">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Appearance</p>
              <div class="mt-2 flex gap-1 rounded-full bg-raised p-1" id="theme-switch">
                <button data-theme-choice="system" class="theme-btn">System</button>
                <button data-theme-choice="light" class="theme-btn">Light</button>
                <button data-theme-choice="dark" class="theme-btn">Dark</button>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Storage</p>
              <dl class="mt-2 flex flex-col gap-1.5 text-[13px]">
                <div class="flex gap-2"><dt class="w-28 shrink-0 text-ink-2">Downloads</dt><dd class="min-w-0 truncate" id="set-dl-dir">…</dd></div>
                <div class="flex gap-2"><dt class="w-28 shrink-0 text-ink-2">App data</dt><dd class="min-w-0 truncate" id="set-data-dir">…</dd></div>
              </dl>
            </div>
            <p class="text-[12px] text-ink-3">
              Transfer-engine settings (connections, concurrency) and language
              arrive with the Settings wave; this screen grows section by section.
            </p>
          </div>
        </section>
      </main>
    </div>

    <style>
      @reference "../styles/global.css";
      .nav-item {
        @apply flex items-center rounded-full px-4 py-2 text-left text-ink-2 transition-colors duration-150;
      }
      .nav-item:hover {
        @apply bg-raised;
      }
      .nav-item.is-active {
        @apply bg-accent-container text-on-accent-container;
      }
      .theme-btn {
        @apply flex-1 rounded-full px-3 py-1.5 text-[12.5px] font-medium text-ink-2 transition-colors duration-150;
      }
      .theme-btn.is-active {
        @apply bg-surface text-ink shadow-sm;
      }
      .chip {
        @apply shrink-0 rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150;
      }
      .chip:hover {
        @apply bg-raised;
      }
      .chip.is-active {
        @apply border-transparent bg-accent-container text-on-accent-container;
      }
    </style>

    <script>
      import {
        feedNext,
        feedOpen,
        getBootstrap,
        getCategories,
        posterSrcs,
        probeSources,
      } from '../lib/api';
      import type {
        BootstrapDto,
        CategoryDto,
        FeedPageDto,
        TaskDto,
        TitleDto,
      } from '../lib/api';

      const status = (id: string) => document.getElementById(id)!;

      // ---- view switching -------------------------------------------------
      function show(view: string) {
        document.querySelectorAll('[data-screen]').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'hidden',
            (el as HTMLElement).dataset.screen !== view,
          );
        });
        document.querySelectorAll('#nav .nav-item').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'is-active',
            (el as HTMLElement).dataset.view === view,
          );
        });
      }
      document.querySelectorAll('#nav .nav-item').forEach((el) => {
        el.addEventListener('click', () =>
          show((el as HTMLElement).dataset.view!),
        );
      });
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        if (e.key === '1') show('library');
        else if (e.key === '2') show('transfers');
        else if (e.key === '3') show('servers');
        else if (e.key === ',') show('settings');
      });
      show('library');

      // ---- formatting ------------------------------------------------------
      function fmtBytes(n: number): string {
        if (n <= 0) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        let i = 0;
        let v = n;
        while (v >= 1024 && i < units.length - 1) {
          v /= 1024;
          i++;
        }
        return (v >= 100 ? Math.round(v) : v.toFixed(1)) + ' ' + units[i];
      }
      const STATE_LABEL: Record<TaskDto['state'], string> = {
        queued: 'Queued',
        running: 'Running',
        paused: 'Paused',
        completed: 'Completed',
        failed: 'Failed',
      };

      function renderTasks(boot: BootstrapDto) {
        const wrap = status('tasks');
        const tasks = boot.downloads.tasks;
        status('tr-status').textContent =
          tasks.length === 0
            ? 'No transfers yet'
            : tasks.length +
              ' transfers · ' +
              boot.downloads.activeCount +
              ' active';
        const badge = status('nav-badge');
        if (boot.downloads.activeCount > 0) {
          badge.textContent = String(boot.downloads.activeCount);
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
        wrap.replaceChildren();
        if (tasks.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'py-10 text-center text-[13px] text-ink-2';
          empty.textContent =
            'Movies and episodes you download appear here with live progress and speed.';
          wrap.append(empty);
          return;
        }
        for (const t of tasks) {
          const card = document.createElement('div');
          card.className =
            'rounded-2xl border border-hairline bg-surface px-4 py-3.5';
          const top = document.createElement('div');
          top.className = 'flex items-baseline gap-3';
          const name = document.createElement('span');
          name.className = 'min-w-0 flex-1 truncate text-[13.5px] font-medium';
          name.textContent = t.name;
          const state = document.createElement('span');
          state.className = 'text-[12px] font-medium text-ink-2';
          state.textContent =
            STATE_LABEL[t.state] +
            (t.state === 'running' || t.state === 'paused'
              ? ' · ' + Math.round(t.fraction * 100) + '%'
              : '');
          top.append(name, state);
          const bar = document.createElement('div');
          bar.className = 'mt-2.5 h-1.5 overflow-hidden rounded-full bg-raised';
          const fill = document.createElement('div');
          fill.className =
            'h-full rounded-full ' +
            (t.state === 'failed'
              ? 'bg-failed'
              : t.state === 'completed'
                ? 'bg-done'
                : t.state === 'paused'
                  ? 'bg-paused'
                  : 'bg-accent');
          fill.style.width = Math.round(t.fraction * 100) + '%';
          bar.append(fill);
          const meta = document.createElement('p');
          meta.className = 'mt-2 text-[12px] tabular-nums text-ink-3';
          meta.textContent =
            fmtBytes(t.downloaded) +
            (t.total > 0 ? ' of ' + fmtBytes(t.total) : '') +
            (t.error ? ' · ' + t.error : '');
          card.append(top, bar, meta);
          wrap.append(card);
        }
      }

      // ---- servers ----------------------------------------------------------
      function dotClass(s: string): string {
        return s === 'up' ? 'bg-done' : s === 'down' ? 'bg-failed' : 'bg-ink-3';
      }
      async function loadProbes() {
        const results = await probeSources();
        const wrap = status('probes');
        wrap.replaceChildren();
        for (const p of results) {
          const row = document.createElement('div');
          row.className =
            'flex items-center gap-3 rounded-2xl border border-hairline bg-surface px-4 py-3';
          const dot = document.createElement('span');
          dot.className = 'h-2 w-2 shrink-0 rounded-full ' + dotClass(p.status);
          const name = document.createElement('span');
          name.className = 'text-[13.5px] font-medium';
          name.textContent = p.name;
          const url = document.createElement('span');
          url.className = 'min-w-0 flex-1 truncate text-[12px] text-ink-3';
          url.textContent = p.rootUrl;
          const state = document.createElement('span');
          state.className = 'text-[12px] tabular-nums text-ink-2';
          state.textContent =
            p.status === 'up'
              ? 'Online · ' + p.latencyMs + ' ms'
              : p.status === 'down'
                ? 'Unreachable'
                : 'Disabled';
          row.append(dot, name, url, state);
          wrap.append(row);
        }
        const up = results.filter((r) => r.status === 'up').length;
        status('srv-status').textContent =
          up + ' of ' + results.length + ' servers online';
        status('rail-servers').textContent = up + ' online';
        status('lib-status').textContent =
          up > 0
            ? up + ' servers online'
            : 'No servers reachable — check the Servers tab';
      }

      // ---- theme -------------------------------------------------------------
      function applyTheme(choice: string) {
        localStorage.setItem('lanfetch-theme', choice);
        const dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelectorAll('.theme-btn').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'is-active',
            (el as HTMLElement).dataset.themeChoice === choice,
          );
        });
      }
      document.querySelectorAll('.theme-btn').forEach((el) => {
        el.addEventListener('click', () =>
          applyTheme((el as HTMLElement).dataset.themeChoice!),
        );
      });
      applyTheme(localStorage.getItem('lanfetch-theme') ?? 'system');

      // ---- library feed -------------------------------------------------------
      // The UX laws this implements (the Rune build broke all three):
      // a click takes effect immediately, a newer load supersedes an
      // older one via generation numbers on BOTH sides, and stale
      // results never paint.
      let libGen = 0;
      let feedGen = 0;
      let feedHasMore = false;
      let pageLoading = false;
      let currentCategory: string | null = null;
      let titleCount = 0;

      function initials(name: string): string {
        return name
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((w) => w[0]!.toUpperCase())
          .join('');
      }

      function makeCard(t: TitleDto, posterSrc: string | null): HTMLElement {
        const card = document.createElement('div');
        card.className = 'cursor-pointer';
        const frame = document.createElement('div');
        frame.className =
          'relative aspect-[2/3] overflow-hidden rounded-xl border border-hairline bg-raised';
        const fallback = document.createElement('div');
        fallback.className =
          'absolute inset-0 flex items-center justify-center text-[26px] font-semibold text-ink-3';
        fallback.textContent = initials(t.title);
        frame.append(fallback);
        if (posterSrc) {
          const img = document.createElement('img');
          img.className = 'absolute inset-0 h-full w-full object-cover';
          img.loading = 'lazy';
          img.draggable = false;
          img.alt = '';
          img.src = posterSrc;
          // A failed poster reveals the initials tile underneath —
          // and because failures are not remembered server-side, the
          // next visit can still succeed.
          img.addEventListener('error', () => img.remove());
          frame.append(img);
        }
        const badgeText =
          t.kind === 'series'
            ? t.seasonCount > 1
              ? t.seasonCount + ' Seasons'
              : 'Series'
            : t.bestQuality;
        if (badgeText) {
          const badge = document.createElement('span');
          badge.className =
            'absolute bottom-1.5 left-1.5 rounded-md bg-black/60 px-1.5 py-0.5 text-[10px] font-semibold text-white';
          badge.textContent = badgeText;
          frame.append(badge);
        }
        if (t.isFavorite) {
          const fav = document.createElement('span');
          fav.className =
            'absolute right-1.5 top-1.5 rounded-md bg-black/60 px-1.5 py-0.5 text-[10px] font-semibold text-white';
          fav.textContent = '★';
          frame.append(fav);
        }
        const name = document.createElement('p');
        name.className =
          'mt-2 line-clamp-2 text-[12.5px] font-medium leading-snug';
        name.textContent = t.title;
        const meta = document.createElement('p');
        meta.className = 'mt-0.5 text-[11px] tabular-nums text-ink-3';
        meta.textContent =
          (t.year ? t.year + ' · ' : '') +
          t.sourceName +
          (t.copies > 1 ? ' · ' + t.copies + ' copies' : '');
        card.append(frame, name, meta);
        return card;
      }

      async function appendPage(
        page: FeedPageDto,
        gen: number,
        first: boolean,
      ): Promise<void> {
        feedHasMore = page.hasMore;
        const grid = status('grid');
        if (first) grid.replaceChildren();
        const withPosters = page.titles.filter((t) => t.posterUrl);
        const srcByUrl = new Map<string, string>();
        if (withPosters.length > 0) {
          const srcs = await posterSrcs(
            withPosters.map((t) => t.posterUrl!),
          );
          if (gen !== libGen) return; // superseded while registering
          withPosters.forEach((t, i) => srcByUrl.set(t.posterUrl!, srcs[i]!));
        }
        for (const t of page.titles) {
          grid.append(
            makeCard(t, t.posterUrl ? (srcByUrl.get(t.posterUrl) ?? null) : null),
          );
        }
        titleCount += page.titles.length;
        status('lib-status').textContent =
          titleCount + ' titles' + (feedHasMore ? ' · scroll for more' : '');
        status('lib-empty').classList.toggle(
          'hidden',
          !(titleCount === 0 && !pageLoading),
        );
      }

      async function openFeed(): Promise<void> {
        const gen = ++libGen;
        titleCount = 0;
        pageLoading = true;
        const grid = status('grid');
        grid.replaceChildren();
        for (let i = 0; i < 12; i++) {
          const sk = document.createElement('div');
          sk.className =
            'aspect-[2/3] animate-pulse rounded-xl border border-hairline bg-raised';
          grid.append(sk);
        }
        status('lib-empty').classList.add('hidden');
        status('lib-status').textContent = 'Loading…';
        try {
          const page = await feedOpen(currentCategory);
          if (gen !== libGen || page.superseded) return;
          feedGen = page.generation;
          await appendPage(page, gen, true);
        } catch {
          if (gen === libGen) {
            grid.replaceChildren();
            status('lib-status').textContent =
              'Could not load the catalog — are the servers reachable?';
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      async function loadMore(): Promise<void> {
        if (pageLoading || !feedHasMore) return;
        pageLoading = true;
        const gen = libGen;
        try {
          const page = await feedNext(feedGen);
          if (gen !== libGen || page.superseded) return;
          await appendPage(page, gen, false);
        } catch {
          // A failed page is not fatal: the sentinel will retry on
          // the next scroll pass.
        } finally {
          pageLoading = false;
        }
      }

      function renderChips(categories: CategoryDto[]): void {
        const wrap = status('chips');
        wrap.replaceChildren();
        const mk = (label: string, value: string | null) => {
          const b = document.createElement('button');
          b.className =
            'chip' + (currentCategory === value ? ' is-active' : '');
          b.textContent = label;
          b.addEventListener('click', () => {
            if (currentCategory === value) return;
            currentCategory = value;
            wrap.querySelectorAll('.chip').forEach((el) => {
              el.classList.toggle('is-active', el === b);
            });
            void openFeed();
          });
          return b;
        };
        wrap.append(mk('All', null));
        for (const c of categories) wrap.append(mk(c.name, c.name));
      }

      async function loadLibrary(refresh: boolean): Promise<void> {
        try {
          const categories = await getCategories(refresh);
          if (categories.length === 0) {
            status('lib-status').textContent =
              'No categories found — check the Servers tab';
            return;
          }
          renderChips(categories);
          void openFeed();
        } catch {
          status('lib-status').textContent =
            'Could not load categories — are the servers reachable?';
        }
      }

      document
        .getElementById('lib-refresh')!
        .addEventListener('click', () => void loadLibrary(true));

      new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) void loadMore();
        },
        { rootMargin: '600px' },
      ).observe(status('sentinel'));

      // ---- boot ---------------------------------------------------------------
      async function main() {
        let boot: BootstrapDto;
        try {
          boot = await getBootstrap();
        } catch {
          status('lib-status').textContent =
            'Not running inside Tauri — this is the browser preview.';
          return;
        }
        status('version').textContent = 'v' + boot.appVersion;
        status('set-dl-dir').textContent = boot.downloadsDir;
        status('set-data-dir').textContent = boot.dataDir;
        renderTasks(boot);
        void loadProbes();
        void loadLibrary(false);
      }
      void main();
    </script>
  </body>
</html>
