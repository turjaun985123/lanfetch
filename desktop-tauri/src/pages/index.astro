              <section class="card p-4" id="set-sec-engine">
                <h2 class="text-heading font-semibold">Download engine</h2>
                <p class="mt-0.5 text-secondary text-ink-2">Values apply to new downloads immediately.</p>
                <div class="mt-3 flex flex-col gap-2.5 text-body">
                  <label class="flex items-center gap-3">
                    <span class="w-44 shrink-0 text-ink-2">Connections per file</span>
                    <select id="set-connections" class="select">
                      <option>1</option><option>2</option><option>4</option><option>6</option>
                      <option>8</option><option>12</option><option>16</option><option>24</option><option>32</option>
