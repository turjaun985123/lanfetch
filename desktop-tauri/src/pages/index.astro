      </main>
    </div>

    <div id="a11y-announcer" class="sr-only" role="status" aria-live="polite"></div>
    <div id="toast-region" class="toast-region"></div>
    <dialog
      id="confirm-dialog"
      class="dialog"
      aria-labelledby="confirm-title"
      aria-describedby="confirm-body"
    >
      <h3 id="confirm-title" class="text-heading font-semibold"></h3>
      <p id="confirm-body" class="mt-1.5 text-body text-ink-2"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button id="confirm-cancel" class="btn btn-ghost btn-sm">Cancel</button>
        <button id="confirm-ok" class="btn btn-danger btn-sm"></button>
      </div>
    </dialog>

    <script>
      import {
        addSource,
        clearCompletedDownloads,
        feedNext,
        feedOpen,
        getBootstrap,
        getCategories,
        getDownloads,
        getTitleDetail,
        onDownloadsChanged,
        pauseDownload,
        posterSrcs,
        probeSources,
        checkUpdate,
        getFavorites,
        pauseAllDownloads,
        redownloadDownload,
        removeDownload,
        removeSource,
        resumeAllDownloads,
        resumeDownload,
        searchTitles,
        setSourceEnabled,
        startDownload,
        toggleFavorite,
        updateSettings,
      } from '../lib/api';
      import type {
        BootstrapDto,
        CategoryDto,
        DownloadListDto,
        FeedPageDto,
        FileDto,
        SettingsDto,
        SourceDto,
        SourceProbeDto,
        TaskDto,
        TitleDetailDto,
        TitleDto,
      } from '../lib/api';
      import {
        STATE_LABEL,
        fmtBytes,
        fmtEta,
        fmtSpeed,
        initials,
      } from '../lib/format';
      import { confirmDialog, el, icon, toast } from '../lib/ui';
      import { createTransfers } from '../lib/transfers';

      const status = (id: string) => document.getElementById(id)!;

      // ---- view switching -------------------------------------------------
      function show(view: string) {
        document.querySelectorAll('[data-screen]').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'hidden',
            (el as HTMLElement).dataset.screen !== view,
          );
        });
        // Focus hygiene (Agent 37): if focus sat inside the
        // section just hidden, it would drop to <body> — move it
        // to the target screen's heading instead. Nav clicks are
        // unaffected (focus is on the rail, outside any section).
        const ae = document.activeElement as HTMLElement | null;
        if (ae && ae !== document.body) {
          const sec = ae.closest('[data-screen]') as HTMLElement | null;
          if (sec && sec.dataset.screen !== view) {
            document
              .querySelector(
                '[data-screen="' + view + '"] .page-title',
              )
              ?.focus({ preventScroll: true });
          }
        }
        // The detail screen belongs to the Library tab.
        const navView = view === 'detail' ? 'library' : view;
        document.querySelectorAll('#nav .nav-item').forEach((el) => {
          const active = (el as HTMLElement).dataset.view === navView;
          (el as HTMLElement).classList.toggle('is-active', active);
          if (active) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
      }

      // ---- rail mode (Agents 11-13) -----------------------------------------
      // data-rail on <html> is the single switch for the compact
      // rail; the pre-paint script set it before first render and
      // this keeps it truthful on resize / toggle. Below 768 the
      // bottom-bar media query owns the layout entirely.
      const railToggle = document.getElementById('rail-toggle');
      function applyRail() {
        const w = window.innerWidth;
        let mode = 'expanded';
        let savedRail: string | null = null;
        try {
          savedRail = localStorage.getItem('lanfetch-rail');
        } catch {
          /* storage unavailable */
        }
        if (w >= 768 && w < 1024) mode = 'compact';
        else if (w >= 1024 && savedRail === 'compact') mode = 'compact';
        document.documentElement.dataset.rail = mode;
        if (railToggle) {
          railToggle.setAttribute(
            'aria-expanded',
            mode === 'expanded' ? 'true' : 'false',
          );
          // In the 768–1023 band the compact rail is forced, so
          // the toggle cannot change anything there — disable it
          // rather than letting it silently no-op (Agent 38).
          const forced = w >= 768 && w < 1024;
          (railToggle as HTMLButtonElement).disabled = forced;
          const label = forced
            ? 'Sidebar is compact at this window width'
            : mode === 'expanded'
              ? 'Collapse sidebar'
              : 'Expand sidebar';
          railToggle.setAttribute('aria-label', label);
          railToggle.setAttribute('title', label);
        }
      }
      applyRail();
      window.addEventListener('resize', applyRail);
      railToggle?.addEventListener('click', () => {
        const compact = document.documentElement.dataset.rail !== 'compact';
        try {
          localStorage.setItem(
            'lanfetch-rail',
            compact ? 'compact' : 'expanded',
          );
        } catch {}
        applyRail();
      });
      document.querySelectorAll('#nav .nav-item').forEach((el) => {
        el.addEventListener('click', () =>
          show((el as HTMLElement).dataset.view!),
        );
      });
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        // Never hijack keys while a modal dialog is open (Agent 49).
        if (document.querySelector('dialog[open]')) return;
        const key = e.key.toLowerCase();
        if (key === '1') show('library');
        else if (key === '2') show('transfers');
        else if (key === '3') show('servers');
        else if (key === ',') show('settings');
        else if (key === 'k' || key === 'f') {
          e.preventDefault();
          // Leave Detail through closeDetail so its focus state
          // stays truthful (Agent 49).
          const detail = document.querySelector('[data-screen="detail"]')!;
          if (!detail.classList.contains('hidden')) closeDetail();
          else show('library');
          document.getElementById('lib-search')!.focus();
        }
      });
      show('library');

      // Transfers screen (V2 Wave 4): the implementation lives in
      // src/lib/transfers.ts behind a state factory. The shell
      // keeps these aliases so the Detail/Library/boot call sites
      // below read exactly as before.
      const transfers = createTransfers({
        status,
        onStamp: () => {
          void refreshDetailFiles();
        },
      });
      const renderDownloads = transfers.renderDownloads;
      const refreshDownloads = transfers.refreshDownloads;
      transfers.mount();

      // ---- servers ----------------------------------------------------------
      let sourcesList: SourceDto[] = [];
      const probeMap = new Map<string, SourceProbeDto>();
      function srvError(msg: string): void {
        const e = status('srv-error');
        e.textContent = msg;
        e.classList.toggle('hidden', msg === '');
      }

      function renderServers(): void {
        const wrap = status('probes');
        wrap.replaceChildren();
        for (const s of sourcesList) {
          const p = probeMap.get(s.name);
          const row = el(
            'div',
            'row-card flex flex-wrap items-center gap-3 px-4 py-3',
          );
          const pill = el(
            'span',
            'badge border border-hairline bg-raised px-2 py-0.5 text-caption font-semibold text-ink-2',
          );
          const dot = el(
            'span',
            'status-dot' +
              (!s.enabled
                ? ' is-disabled'
                : p?.status === 'up'
                  ? ' is-up'
                  : p?.status === 'down'
                    ? ' is-down'
                    : ''),
          );
          pill.append(
            dot,
            document.createTextNode(
              !s.enabled
                ? 'Disabled'
                : p?.status === 'up'
                  ? 'Online · ' + p.latencyMs + ' ms'
                  : p?.status === 'down'
                    ? 'Unreachable'
                    : 'Checking…',
            ),
          );
          const name = el('span', 'text-row font-medium', s.name);
          const url = el(
            'span',
            'min-w-0 flex-1 truncate text-secondary text-ink-3',
            s.rootUrl,
          );
          url.title = s.rootUrl;
          const main = el('div', 'flex min-w-0 flex-1 items-center gap-3');
          main.append(pill, name, url);
          const toggle = document.createElement('input');
          toggle.type = 'checkbox';
          toggle.checked = s.enabled;
          toggle.className = 'switch';
          toggle.setAttribute(
            'aria-label',
            (s.enabled ? 'Disable ' : 'Enable ') + s.name,
          );
          toggle.addEventListener('change', async () => {
            try {
              sourcesList = await setSourceEnabled(s.name, toggle.checked);
              renderServers();
              void loadProbes();
            } catch {
              toggle.checked = !toggle.checked;
            }
          });
          row.append(main, toggle);
          if (s.custom) {
            const rm = document.createElement('button');
            rm.className = 'btn btn-danger btn-sm shrink-0';
            rm.replaceChildren(
              icon('trash', 16),
              document.createTextNode('Remove'),
            );
            rm.addEventListener('click', async () => {
              const ok = await confirmDialog({
                title: 'Remove this server?',
                body: '“' + s.name + '” will be removed from LanFetch.',
                confirmLabel: 'Remove',
              });
              if (!ok) return;
              try {
                sourcesList = await removeSource(s.name);
                probeMap.delete(s.name);
                renderServers();
                void loadProbes();
              } catch (e) {
                srvError(String(e));
              }
            });
            row.append(rm);
          }
          wrap.append(row);
        }
        renderRailServers();
      }

      // Expanded-rail server list (Agent 23): the same
      // sourcesList/probeMap, no new data path.
      function renderRailServers(): void {
        const host = status('rail-servers');
        host.replaceChildren();
        const up = sourcesList.filter(
          (s) => s.enabled && probeMap.get(s.name)?.status === 'up',
        ).length;
        for (const s of sourcesList.slice(0, 5)) {
          const p = probeMap.get(s.name);
          const row = el(
            'div',
            'flex items-center gap-2 px-1 py-0.5 text-secondary',
          );
          row.append(
            el(
              'span',
              'status-dot' +
                (!s.enabled
                  ? ' is-disabled'
                  : p?.status === 'up'
                    ? ' is-up'
                    : p?.status === 'down'
                      ? ' is-down'
                      : ''),
            ),
            el('span', 'min-w-0 flex-1 truncate', s.name),
          );
          if (s.enabled && p?.status === 'up') {
            row.append(
              el('span', 'tabular-nums text-ink-3', p.latencyMs + ' ms'),
            );
          }
          host.append(row);
        }
        host.append(
          el(
            'p',
            'px-1 pt-1 text-caption text-ink-3',
            up + ' of ' + sourcesList.length + ' online',
          ),
        );
      }
      async function loadProbes() {
        const results = await probeSources();
        probeMap.clear();
        for (const p of results) probeMap.set(p.name, p);
        renderServers();
        const up = results.filter((r) => r.status === 'up').length;
        status('srv-status').textContent =
          up + ' of ' + results.length + ' servers online';
        // Compact rail: server health survives as a dot on the
        // Servers nav item (Agent 12); words live in its label.
        const railDot = document.getElementById('rail-servers-dot');
        if (railDot) {
          railDot.className =
            'rail-dot status-dot' +
            (up > 0 ? ' is-up' : results.length > 0 ? ' is-down' : '');
        }
        document
          .querySelector('#nav .nav-item[data-view="servers"]')
          ?.setAttribute('aria-label', 'Servers, ' + up + ' online');
        if (titleCount === 0 && activeQuery === '') {
          status('lib-status').textContent =
            up > 0
              ? up + ' servers online'
              : 'No servers reachable — check the Servers tab';
        }
      }
      // Add-server: honest minimal validation only (Agent 23) —
      // non-empty name, non-empty whitespace-free address. No
      // scheme or URL-parser gate: the engine accepts what it
      // accepts, and a missing scheme earns a hint, not a block.
      const srvNameEl = document.getElementById('srv-name') as HTMLInputElement;
      const srvUrlEl = document.getElementById('srv-url') as HTMLInputElement;
      const srvAddBtn = status('srv-add') as HTMLButtonElement;
      function validateSrvForm(): void {
        const ok =
          srvNameEl.value.trim().length > 0 &&
          srvUrlEl.value.trim().length > 0 &&
          !/\s/.test(srvUrlEl.value.trim());
        srvAddBtn.disabled = !ok;
        status('srv-hint').classList.toggle(
          'hidden',
          !(srvUrlEl.value.trim().length > 0 && !srvUrlEl.value.includes('://')),
        );
      }
      srvNameEl.addEventListener('input', validateSrvForm);
      srvUrlEl.addEventListener('input', validateSrvForm);
      srvAddBtn.addEventListener('click', async () => {
        srvError('');
        srvAddBtn.disabled = true;
        srvAddBtn.textContent = 'Adding…';
        try {
          sourcesList = await addSource(srvNameEl.value, srvUrlEl.value);
          const added = srvNameEl.value;
          srvNameEl.value = '';
          srvUrlEl.value = '';
          renderServers();
          void loadProbes();
          toast('Server ' + added + ' added');
        } catch (e) {
          srvError(String(e));
        } finally {
          srvAddBtn.textContent = 'Add server';
          validateSrvForm();
        }
      });
      document
        .getElementById('srv-refresh')!
        .addEventListener('click', async () => {
          const btn = status('srv-refresh') as HTMLButtonElement;
          btn.disabled = true;
          btn.classList.add('is-busy');
          btn.setAttribute('aria-busy', 'true');
          try {
            await loadProbes();
          } finally {
            btn.disabled = false;
            btn.classList.remove('is-busy');
            btn.removeAttribute('aria-busy');
          }
        });

      // ---- theme -------------------------------------------------------------
      function applyTheme(choice: string) {
        // One-frame transition suppression (Agent 32): without
        // it, every transition-colors control cross-fades muddy
        // when the theme flips.
        const root = document.documentElement;
        root.classList.add('theme-switching');
        // Storage can throw (blocked cookies, strict private
        // modes) — the theme must still apply (Agent 46).
        try {
          localStorage.setItem('lanfetch-theme', choice);
        } catch {
          /* pre-paint cache only; settings.json is the truth */
        }
        const dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => root.classList.remove('theme-switching'));
        });
        document.querySelectorAll('.theme-btn').forEach((el) => {
          const active =
            (el as HTMLElement).dataset.themeChoice === choice;
          (el as HTMLElement).classList.toggle('is-active', active);
          el.setAttribute('aria-checked', String(active));
          (el as HTMLElement).tabIndex = active ? 0 : -1;
        });
      }
      document.querySelectorAll('.theme-btn').forEach((el) => {
        el.addEventListener('click', () => {
          const choice = (el as HTMLElement).dataset.themeChoice!;
          applyTheme(choice);
          void persistSettings({ theme: choice });
        });
      });
      // Radiogroup arrows (Agent 31): Left/Right move and select,
      // matching the radio pattern the markup declares.
      status('theme-switch').addEventListener('keydown', (e) => {
        if (
          e.key !== 'ArrowRight' &&
          e.key !== 'ArrowLeft' &&
          e.key !== 'ArrowDown' &&
          e.key !== 'ArrowUp'
        )
          return;
        const btns = [
          ...document.querySelectorAll('.theme-btn'),
        ] as HTMLElement[];
        const i = btns.findIndex(
          (b) => b.getAttribute('aria-checked') === 'true',
        );
        if (i < 0) return;
        const forward = e.key === 'ArrowRight' || e.key === 'ArrowDown';
        const j = forward
          ? (i + 1) % btns.length
          : (i - 1 + btns.length) % btns.length;
        e.preventDefault();
        btns[j]!.focus();
        btns[j]!.click();
      });
      let savedTheme = 'system';
      try {
        savedTheme = localStorage.getItem('lanfetch-theme') ?? 'system';
      } catch {
        /* storage unavailable — fall back to system */
      }
      applyTheme(savedTheme);

      // ---- settings ---------------------------------------------------------------
      let currentSettings: SettingsDto | null = null;
      async function persistSettings(
        patch: Partial<SettingsDto>,
      ): Promise<void> {
        if (!currentSettings) return;
        try {
          currentSettings = await updateSettings({
            ...currentSettings,
            ...patch,
          });
        } catch {
          // Browser preview or IPC failure: the local UI state the
          // user just set stays as they left it.
        }
      }
      const sel = (id: string) =>
        document.getElementById(id) as HTMLSelectElement;
      sel('set-connections').addEventListener('change', () =>
        void persistSettings({
          connections: parseInt(sel('set-connections').value, 10),
        }),
      );
      sel('set-concurrent').addEventListener('change', () =>
        void persistSettings({
          maxConcurrent: parseInt(sel('set-concurrent').value, 10),
        }),
      );
      sel('set-language').addEventListener('change', () =>
        void persistSettings({ language: sel('set-language').value }),
      );

      // Settings section nav (Agent 24): plain anchors, click
      // marks the section active and smooth-scrolls; no scrollspy,
      // no router.
      document.querySelectorAll('.settings-nav-item').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          document.querySelectorAll('.settings-nav-item').forEach((x) => {
            x.classList.toggle('is-active', x === a);
            if (x === a) x.setAttribute('aria-current', 'true');
            else x.removeAttribute('aria-current');
          });
          const target = document.getElementById(
            (a as HTMLElement).dataset.sec!,
          );
          // JS smooth scrolling ignores the CSS reduced-motion
          // rule — honor the preference here (Agent 44).
          const reduce = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches;
          target?.scrollIntoView({
            behavior: reduce ? 'auto' : 'smooth',
            block: 'start',
          });
        });
      });

      // Storage path copy buttons (Agent 24): Clipboard API
      // first, hidden-textarea fallback for insecure web origins
      // (Agent 30 — clipboard is undefined on http:// LAN IPs).
      document.querySelectorAll('[data-copy-target]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const target = status(
            (btn as HTMLElement).dataset.copyTarget!,
          );
          const text = target.textContent ?? '';
          if (!text || text === '…') return;
          let ok = false;
          try {
            await navigator.clipboard.writeText(text);
            ok = true;
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.append(ta);
            ta.select();
            try {
              ok = document.execCommand('copy');
            } catch {
              ok = false;
            }
            ta.remove();
          }
          if (ok) {
            const use = btn.querySelector('use');
            use?.setAttribute('href', '#i-check');
            window.setTimeout(
              () => use?.setAttribute('href', '#i-copy'),
              1500,
            );
            toast('Copied to clipboard');
          } else {
            toast('Copy failed — the path is shown in Settings.', 'alert');
          }
        });
      });

      // ---- library feed -------------------------------------------------------
      // The UX laws this implements (the Rune build broke all three):
      // a click takes effect immediately, a newer load supersedes an
      // older one via generation numbers on BOTH sides, and stale
      // results never paint.
      let libGen = 0;
      let feedGen = 0;
      let feedHasMore = false;
      let pageLoading = false;
      let currentCategory: string | null = null;
      let titleCount = 0;

      // ---- library banner + empty states (Agents 16/25) ---------------------
      // Errors are banners with Retry, never gray footnotes in the
      // status line; empty results are calm empty states. The two
      // never substitute for each other.
      let bannerRetry: (() => void) | null = null;
      function showBanner(
        kind: 'error' | 'info',
        msg: string,
        retryLabel: string | null,
        retry: (() => void) | null,
      ): void {
        const banner = status('lib-banner');
        banner.classList.remove('hidden');
        const iconSpan = status('lib-banner-icon');
        iconSpan.className = kind === 'error' ? 'text-failed' : 'text-ink-2';
        iconSpan.replaceChildren(icon(kind === 'error' ? 'warning' : 'info', 20));
        status('lib-banner-text').textContent = msg;
        const btn = status('lib-banner-retry') as HTMLButtonElement;
        bannerRetry = retry;
        if (retry && retryLabel) {
          btn.classList.remove('hidden');
          btn.replaceChildren(icon('retry', 16), document.createTextNode(retryLabel));
        } else {
          btn.classList.add('hidden');
        }
      }
      function hideBanner(): void {
        status('lib-banner').classList.add('hidden');
        bannerRetry = null;
      }
      status('lib-banner-retry').addEventListener('click', () => {
        const retry = bannerRetry;
        hideBanner();
        retry?.();
      });
      status('lib-banner-close').addEventListener('click', () => hideBanner());

      let emptyAction: (() => void) | null = null;
      function setEmpty(
        variant: 'feed' | 'search' | 'favorites' | 'nocats',
      ): void {
        const wrap = status('lib-empty');
        wrap.classList.remove('hidden');
        const iconSpan = status('lib-empty-icon');
        const title = status('lib-empty-title');
        const body = status('lib-empty-body');
        const action = status('lib-empty-action') as HTMLButtonElement;
        if (variant === 'nocats') {
          iconSpan.replaceChildren(icon('servers', 24));
          title.textContent = 'No categories found';
          body.textContent =
            'Your servers returned no categories. Check that at least one server is enabled and reachable.';
          action.textContent = 'Open Servers';
          emptyAction = () => show('servers');
        } else if (variant === 'search') {
          iconSpan.replaceChildren(icon('search', 24));
          title.textContent = 'No results for “' + activeQuery + '”';
          body.textContent =
            'Nothing on the servers matches that title. Check the spelling, or try a shorter search.';
          action.textContent = 'Clear search';
          emptyAction = () => clearSearch();
        } else if (variant === 'favorites') {
          iconSpan.replaceChildren(icon('star', 24));
          title.textContent = 'No favorites yet';
          body.textContent =
            'Open a title and tap the star to keep it here. Favorites are saved on this device.';
          action.textContent = 'Browse library';
          emptyAction = () => {
            currentCategory = null;
            favoritesActive = false;
            void openFeed();
          };
        } else {
          iconSpan.replaceChildren(icon('film', 24));
          title.textContent = 'Nothing here yet';
          body.textContent =
            'No titles in this category right now. If the servers just came online, Refresh reloads the catalog.';
          action.textContent = 'Refresh';
          emptyAction = () => void loadLibrary(true);
        }
      }
      function hideEmpty(): void {
        status('lib-empty').classList.add('hidden');
      }
      status('lib-empty-action').addEventListener('click', () => {
        emptyAction?.();
      });

      function showSkeletons(): void {
        const grid = status('grid');
        grid.replaceChildren();
        grid.setAttribute('aria-busy', 'true');
        for (let i = 0; i < 12; i++) {
          const card = el('div', 'skeleton-card');
          card.setAttribute('aria-hidden', 'true');
          const frame = el('div', 'skeleton skeleton-poster');
          const bar1 = el('div', 'skeleton mt-2 h-3 w-[85%]');
          const bar2 = el('div', 'skeleton mt-1 h-2.5 w-[55%]');
          card.append(frame, bar1, bar2);
          grid.append(card);
        }
      }

      // Poster failures are delegated (Agent 33): one capturing
      // listener instead of one per card. A failed poster reveals
      // the glyph tile underneath — and because failures are not
      // remembered server-side, the next visit can still succeed.
      status('grid').addEventListener(
        'error',
        (e) => {
          if (e.target instanceof HTMLImageElement) e.target.remove();
        },
        true,
      );

      function makeCard(
        t: TitleDto,
        posterSrc: string | null,
        eager = false,
      ): HTMLElement {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'poster-card';
        // The accessible name carries everything the badges show
        // visually (Agent 17): badges themselves are decorative.
        card.setAttribute(
          'aria-label',
          t.title +
            (t.year ? ', ' + t.year : '') +
            (t.kind === 'series'
              ? ', series' +
                (t.seasonCount > 1 ? ', ' + t.seasonCount + ' seasons' : '') +
                (t.bestQuality ? ', ' + t.bestQuality : '')
              : t.bestQuality
                ? ', ' + t.bestQuality
                : '') +
            (t.isFavorite ? ', favorited' : ''),
        );
        const frame = el('span', 'poster-frame');
        const fallback = el('span', 'poster-fallback');
        fallback.setAttribute('aria-hidden', 'true');
        const glyph = icon('logo', 32);
        glyph.style.opacity = '0.35';
        fallback.append(glyph);
        frame.append(fallback);
        if (posterSrc) {
          const img = document.createElement('img');
          img.className = 'poster-img';
          img.loading = eager ? 'eager' : 'lazy';
          if (eager) img.setAttribute('fetchpriority', 'high');
          img.decoding = 'async';
          img.draggable = false;
          img.alt = '';
          img.addEventListener('load', () => img.classList.add('is-loaded'));
          img.src = posterSrc;
          if (img.complete && img.naturalWidth > 0)
            img.classList.add('is-loaded');
          frame.append(img);
        }
        const badgeText =
          t.kind === 'series'
            ? t.seasonCount > 1
              ? t.seasonCount + ' Seasons'
              : 'Series'
            : t.bestQuality;
        if (badgeText) {
          const badge = el(
            'span',
            'badge badge-scrim absolute bottom-1.5 left-1.5',
            badgeText,
          );
          badge.setAttribute('aria-hidden', 'true');
          frame.append(badge);
        }
        if (t.isFavorite) {
          const fav = el('span', 'badge badge-scrim absolute right-1.5 top-1.5');
          fav.setAttribute('aria-hidden', 'true');
          fav.append(icon('star-filled', 16));
          frame.append(fav);
        }
        const name = el('span', 'poster-title', t.title);
        const meta = el(
          'span',
          'poster-meta',
          (t.year ? t.year + ' · ' : '') +
            (t.language ? t.language + ' · ' : '') +
            t.sourceName +
            (t.copies > 1 ? ' · ' + t.copies + ' copies' : ''),
        );
        card.append(frame, name, meta);
        card.addEventListener('click', () => void openDetail(t));
        return card;
      }

      /** Paint titles into the grid (poster batch first). Returns
       * false when the generation was superseded mid-paint — the
       * caller then drops everything. */
      async function paintTitles(
        titles: TitleDto[],
        gen: number,
        first: boolean,
      ): Promise<boolean> {
        const grid = status('grid');
        if (first) grid.replaceChildren();
        const withPosters = titles.filter((t) => t.posterUrl);
        const srcByUrl = new Map<string, string>();
        if (withPosters.length > 0) {
          const srcs = await posterSrcs(
            withPosters.map((t) => t.posterUrl!),
          );
          if (gen !== libGen) return false; // superseded while registering
          withPosters.forEach((t, i) => srcByUrl.set(t.posterUrl!, srcs[i]!));
        }
        const frag = document.createDocumentFragment();
        titles.forEach((t, i) => {
          frag.append(
            makeCard(
              t,
              t.posterUrl ? (srcByUrl.get(t.posterUrl) ?? null) : null,
              first && i < 12,
            ),
          );
        });
        grid.append(frag);
        if (first) grid.removeAttribute('aria-busy');
        return true;
      }

      async function appendPage(
        page: FeedPageDto,
        gen: number,
        first: boolean,
      ): Promise<void> {
        feedHasMore = page.hasMore;
        if (!(await paintTitles(page.titles, gen, first))) return;
        titleCount += page.titles.length;
        status('lib-status').textContent =
          titleCount + ' titles' + (feedHasMore ? ' · scroll for more' : '');
        if (first) {
          if (titleCount === 0) setEmpty('feed');
          else hideEmpty();
          hideBanner();
        }
      }

      async function openFeed(): Promise<void> {
        const gen = ++libGen;
        activeQuery = '';
        favoritesActive = false;
        titleCount = 0;
        pageLoading = true;
        paintChips();
        showSkeletons();
        hideEmpty();
        syncSearchChrome();
        status('lib-status').textContent = 'Loading…';
        try {
          const page = await feedOpen(currentCategory);
          if (gen !== libGen || page.superseded) return;
          feedGen = page.generation;
          await appendPage(page, gen, true);
        } catch {
          if (gen === libGen) {
            status('grid').replaceChildren();
            status('grid').removeAttribute('aria-busy');
            showBanner(
              'error',
              'Could not load the catalog — are the servers reachable?',
              'Retry',
              () => void openFeed(),
            );
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      let pageErrorGen = -1;
      async function loadMore(): Promise<void> {
        if (pageLoading || !feedHasMore) return;
        pageLoading = true;
        const gen = libGen;
        try {
          const page = await feedNext(feedGen);
          if (gen !== libGen || page.superseded) return;
          await appendPage(page, gen, false);
        } catch {
          // Not fatal — the sentinel retries on the next scroll
          // pass — but a persistent failure must surface
          // somewhere (Agent 41): banner, once per generation.
          if (pageErrorGen !== gen) {
            pageErrorGen = gen;
            showBanner('error', 'Could not load more titles.', 'Retry', () =>
              void loadMore(),
            );
          }
        } finally {
          pageLoading = false;
        }
      }

      let favoritesActive = false;
      async function openFavorites(): Promise<void> {
        const gen = ++libGen;
        favoritesActive = true;
        activeQuery = '';
        feedHasMore = false;
        titleCount = 0;
        pageLoading = true;
        paintChips();
        showSkeletons();
        hideEmpty();
        syncSearchChrome();
        status('lib-status').textContent = 'Loading favorites…';
        try {
          const favs = await getFavorites();
          if (gen !== libGen) return;
          if (!(await paintTitles(favs, gen, true))) return;
          titleCount = favs.length;
          status('lib-status').textContent = favs.length + ' favorites';
          if (favs.length === 0) setEmpty('favorites');
          else hideEmpty();
          hideBanner();
        } catch {
          if (gen === libGen) {
            status('grid').removeAttribute('aria-busy');
            showBanner('error', 'Could not load favorites.', 'Retry', () =>
              void openFavorites(),
            );
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      // Chip state is derived, never toggled ad hoc (Agent 18):
      // paintChips() re-derives is-active / aria-pressed / roving
      // tabindex from (activeQuery, favoritesActive, currentCategory)
      // — including after a search, which selects no chip. That is
      // the fix for the old bug where searching from Favorites left
      // the Favorites chip highlighted.
      function paintChips(scroll = false): void {
        const wrap = status('chips');
        let roving: HTMLElement | null = null;
        let fallback: HTMLElement | null = null;
        wrap.querySelectorAll('.chip').forEach((el) => {
          const b = el as HTMLElement;
          const kind = b.dataset.chipKind;
          const active =
            activeQuery !== ''
              ? false
              : kind === 'fav'
                ? favoritesActive
                : kind === 'cat' &&
                  !favoritesActive &&
                  (b.dataset.chipValue ?? '') === (currentCategory ?? '');
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
          if (active) roving = b;
          if (
            kind === 'cat' &&
            (b.dataset.chipValue ?? '') === (currentCategory ?? '')
          )
            fallback = b;
        });
        const target = roving ?? fallback ?? wrap.querySelector('.chip');
        wrap.querySelectorAll('.chip').forEach((el) => {
          (el as HTMLElement).tabIndex = el === target ? 0 : -1;
        });
        const favIcon = wrap.querySelector('.fav-chip-icon');
        if (favIcon)
          favIcon.replaceChildren(
            icon(favoritesActive ? 'star-filled' : 'star', 16),
          );
        if (scroll && target)
          (target as HTMLElement).scrollIntoView({
            block: 'nearest',
            inline: 'nearest',
          });
      }

      function renderChips(categories: CategoryDto[]): void {
        const wrap = status('chips');
        wrap.replaceChildren();
        const mk = (
          label: string,
          value: string | null,
          sources?: string[],
        ) => {
          const b = document.createElement('button');
          b.className = 'chip';
          b.dataset.chipKind = 'cat';
          b.dataset.chipValue = value ?? '';
          b.textContent = label;
          if (sources && sources.length > 0)
            b.title = 'On: ' + sources.join(', ');
          b.addEventListener('click', () => {
            if (currentCategory === value && !favoritesActive) return;
            currentCategory = value;
            favoritesActive = false;
            void openFeed();
          });
          return b;
        };
        wrap.append(mk('All', null));
        const favChip = document.createElement('button');
        favChip.className = 'chip';
        favChip.dataset.chipKind = 'fav';
        const favIcon = el('span', 'fav-chip-icon');
        favIcon.setAttribute('aria-hidden', 'true');
        favChip.append(favIcon, document.createTextNode('Favorites'));
        favChip.addEventListener('click', () => {
          if (favoritesActive) return;
          void openFavorites();
        });
        wrap.append(favChip);
        for (const c of categories) wrap.append(mk(c.name, c.name, c.sources));
        // Roving tabindex (Agent 18): arrows move focus only,
        // Enter/Space activate via the native click.
        wrap.onkeydown = (e) => {
          const chips = [...wrap.querySelectorAll('.chip')] as HTMLElement[];
          const i = chips.indexOf(document.activeElement as HTMLElement);
          if (i < 0) return;
          let j: number | null = null;
          if (e.key === 'ArrowRight') j = (i + 1) % chips.length;
          else if (e.key === 'ArrowLeft')
            j = (i - 1 + chips.length) % chips.length;
          else if (e.key === 'Home') j = 0;
          else if (e.key === 'End') j = chips.length - 1;
          if (j !== null) {
            e.preventDefault();
            chips.forEach((c, k) => (c.tabIndex = k === j ? 0 : -1));
            chips[j]!.focus();
          }
        };
        paintChips();
      }

      async function loadLibrary(refresh: boolean): Promise<void> {
        try {
          const categories = await getCategories(refresh);
          if (categories.length === 0) {
            // An empty catalog is an empty state, not a status
            // line footnote (Agents 25/41).
            status('lib-status').textContent = '';
            status('grid').replaceChildren();
            setEmpty('nocats');
            return;
          }
          hideEmpty();
          hideBanner();
          renderChips(categories);
          void openFeed();
        } catch {
          showBanner(
            'error',
            'Could not load categories — are the servers reachable?',
            'Retry',
            () => void loadLibrary(true),
          );
        }
      }

      document
        .getElementById('lib-refresh')!
        .addEventListener('click', async () => {
          const btn = status('lib-refresh') as HTMLButtonElement;
          btn.disabled = true;
          btn.classList.add('is-busy');
          btn.setAttribute('aria-busy', 'true');
          try {
            await loadLibrary(true);
          } finally {
            btn.disabled = false;
            btn.classList.remove('is-busy');
            btn.removeAttribute('aria-busy');
          }
        });

      new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) void loadMore();
        },
        { rootMargin: '600px' },
      ).observe(status('sentinel'));

      // ---- search ---------------------------------------------------------------
      // Search and the feed share one generation counter: whichever
      // starts last owns the grid, and the loser's results are
      // dropped even if they arrive later.
      let searchTimer: number | undefined;
      let activeQuery = '';
      async function runSearch(q: string): Promise<void> {
        const gen = ++libGen;
        activeQuery = q;
        favoritesActive = false;
        feedHasMore = false;
        titleCount = 0;
        pageLoading = true;
        paintChips();
        showSkeletons();
        hideEmpty();
        status('lib-status').textContent = 'Searching…';
        try {
          const results = await searchTitles(q);
          if (gen !== libGen) return;
          if (!(await paintTitles(results, gen, true))) return;
          titleCount = results.length;
          status('lib-status').textContent =
            results.length + ' results for “' + q + '”';
          if (results.length === 0) setEmpty('search');
          else hideEmpty();
          hideBanner();
        } catch {
          if (gen === libGen) {
            status('grid').removeAttribute('aria-busy');
            showBanner(
              'error',
              'Search failed — are the servers reachable?',
              'Retry',
              () => void runSearch(q),
            );
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }
      const searchInput = document.getElementById(
        'lib-search',
      ) as HTMLInputElement;
      // Clear button + Ctrl-K hint visibility follows the field.
      function syncSearchChrome(): void {
        const hasText = searchInput.value.length > 0;
        status('lib-clear').classList.toggle('hidden', !hasText);
        document
          .querySelector('.search-hint')
          ?.classList.toggle('hidden', hasText);
      }
      function clearSearch(): void {
        window.clearTimeout(searchTimer);
        searchInput.value = '';
        syncSearchChrome();
        if (activeQuery !== '') void openFeed();
      }
      status('lib-clear').addEventListener('click', () => {
        clearSearch();
        searchInput.focus();
      });
      searchInput.addEventListener('input', () => {
        syncSearchChrome();
        const q = searchInput.value.trim();
        window.clearTimeout(searchTimer);
        if (q.length === 0) {
          if (activeQuery !== '') void openFeed();
          return;
        }
        searchTimer = window.setTimeout(() => void runSearch(q), 300);
      });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const q = searchInput.value.trim();
          window.clearTimeout(searchTimer);
          if (q) void runSearch(q);
        } else if (e.key === 'Escape') {
          clearSearch();
        }
      });

      // ---- title detail ---------------------------------------------------------
      let detailGen = 0;
      let detailTitle: TitleDto | null = null;

      // File actions (Agent 20). The old Paused button was a
      // disabled dead-end: start_download does NOT resume a paused
      // task (verified in engine manager.rs — enqueue dedups by
      // URL and silently returns). A real resume finds the task by
      // URL and calls resumeDownload; failed tasks resume only
      // when the engine says the partial is ready, otherwise they
      // re-probe through startDownload.
      const pendingFileClicks = new Set<string>();
      function fileButton(f: FileDto): HTMLButtonElement {
        const b = document.createElement('button');
        const paint = () => {
          switch (f.downloadState) {
            case 'queued':
              b.className = 'btn btn-ghost btn-sm shrink-0';
              b.replaceChildren(icon('clock', 16), document.createTextNode('Queued'));
              b.disabled = true;
              break;
            case 'running':
              b.className = 'btn btn-ghost btn-sm shrink-0';
              b.textContent =
                'Downloading ' +
                Math.round((f.downloadFraction ?? 0) * 100) +
                '%';
              b.disabled = true;
              break;
            case 'paused':
              b.className = 'btn btn-ghost btn-sm shrink-0';
              b.replaceChildren(icon('play', 16), document.createTextNode('Resume'));
              b.disabled = false;
              break;
            case 'completed':
              b.className = 'btn btn-ghost btn-sm shrink-0';
              b.replaceChildren(icon('check', 16), document.createTextNode('Downloaded'));
              b.disabled = true;
              break;
            case 'failed':
              b.className = 'btn btn-primary btn-sm shrink-0';
              b.replaceChildren(icon('retry', 16), document.createTextNode('Retry'));
              b.disabled = false;
              break;
            default:
              b.className = 'btn btn-primary btn-sm shrink-0';
              b.replaceChildren(icon('download', 16), document.createTextNode('Download'));
              b.disabled = false;
          }
          // The accessible name carries the file (Agent 37).
          b.setAttribute(
            'aria-label',
            (b.textContent ?? '') + ' — ' + f.fileName,
          );
        };
        paint();
        b.addEventListener('click', async () => {
          if (pendingFileClicks.has(f.fileUrl)) return;
          pendingFileClicks.add(f.fileUrl);
          b.disabled = true;
          b.textContent = 'Working…';
          try {
            let acted = false;
            if (f.downloadState === 'paused' || f.downloadState === 'failed') {
              try {
                const list = await getDownloads();
                const task = list.tasks.find((x) => x.url === f.fileUrl);
                if (task && (f.downloadState === 'paused' || task.ready)) {
                  renderDownloads(await resumeDownload(task.id));
                  acted = true;
                }
              } catch {
                // fall through to a fresh startDownload
              }
            }
            if (!acted) {
              renderDownloads(await startDownload(f.fileUrl, f.fileName));
            }
            f.downloadState = 'queued';
            f.downloadFraction = 0;
            paint();
            void refreshDetailFiles();
          } catch {
            paint();
          } finally {
            pendingFileClicks.delete(f.fileUrl);
            // Drain any refresh that deferred while this click
            // was in flight (Agent 40).
            void refreshDetailFiles();
          }
        });
        return b;
      }

      function renderFiles(detail: TitleDetailDto): void {
        const wrap = status('detail-files');
        wrap.replaceChildren();
        if (detail.files.length === 0) {
          const empty = el('div', 'empty-state');
          empty.setAttribute('role', 'status');
          const ic = el('span', 'text-ink-3');
          ic.append(icon('film', 24));
          const h = el('h4', 'mt-3 text-heading font-semibold', 'No downloadable files');
          const p = el(
            'p',
            'mt-1 max-w-[420px] text-body text-ink-2',
            'This folder holds no video files LanFetch can fetch.',
          );
          empty.append(ic, h, p);
          wrap.append(empty);
          return;
        }
        const isSeries = detail.title.kind === 'series';
        const seasons = new Map<number, FileDto[]>();
        for (const f of detail.files) {
          const key = isSeries ? (f.season ?? 0) : 0;
          const arr = seasons.get(key) ?? [];
          arr.push(f);
          seasons.set(key, arr);
        }
        for (const season of [...seasons.keys()].sort((a, b) => a - b)) {
          const files = seasons.get(season)!;
          if (isSeries) {
            const head = el('div', 'mt-2 flex items-center justify-between gap-2');
            head.append(
              el(
                'span',
                'section-label',
                (season > 0 ? 'Season ' + season : 'Episodes') +
                  ' · ' +
                  files.length +
                  ' files',
              ),
            );
            const actionable = files.filter(
              (f) => !f.downloadState || f.downloadState === 'failed',
            );
            if (files.length >= 2 && actionable.length >= 2) {
              const all = el('button', 'btn btn-ghost btn-sm', 'Download all');
              all.addEventListener('click', async () => {
                all.disabled = true;
                all.textContent = 'Queueing…';
                let last: DownloadListDto | null = null;
                try {
                  for (const f of actionable) {
                    try {
                      last = await startDownload(f.fileUrl, f.fileName);
                    } catch {
                      // one bad file must not stop the season
                    }
                  }
                  if (last) renderDownloads(last);
                } finally {
                  // If every start failed, restore the button —
                  // otherwise it wedges on "Queueing…" until the
                  // next re-render (Agent 40).
                  if (!last) {
                    all.disabled = false;
                    all.textContent = 'Download all';
                  }
                  void refreshDetailFiles();
                }
              });
              head.append(all);
            }
            wrap.append(head);
          }
          for (const f of files) {
            const row = el(
              'div',
              'row-card relative flex items-center gap-3 overflow-hidden px-3.5 py-3',
            );
            row.dataset.fileUrl = f.fileUrl;
            const text = el('div', 'min-w-0 flex-1');
            const name = el('p', 'truncate text-row font-medium', f.fileName);
            name.title = f.fileName;
            const sub = el(
              'div',
              'mt-0.5 flex items-center gap-1.5 text-secondary tabular-nums text-ink-3',
            );
            sub.append(
              document.createTextNode(
                (f.episode != null ? 'E' + f.episode + ' · ' : '') +
                  (f.size >= 0 ? fmtBytes(f.size) : 'Size unknown') +
                  (f.quality ? ' · ' + f.quality : '') +
                  (f.codec ? ' · ' + f.codec : '') +
                  (f.audio ? ' · ' + f.audio : ''),
              ),
            );
            if (f.sourceTag) {
              sub.append(
                el(
                  'span',
                  'badge border border-hairline bg-raised px-1.5 py-0.5 text-caption font-medium text-ink-2',
                  f.sourceTag,
                ),
              );
            }
            text.append(name, sub);
            row.append(text, fileButton(f));
            if (f.downloadState === 'running') {
              const bar = el('div', 'file-progress');
              bar.style.width =
                Math.round((f.downloadFraction ?? 0) * 100) + '%';
              row.append(bar);
            }
            wrap.append(row);
          }
        }
      }

      // Live detail refresh (Agent 20): downloads-changed events
      // re-fetch the open title, but the file list re-renders only
      // when its signature actually changed — no flicker, no lost
      // scroll position, no clobbering a click in flight.
      let detailFilesSig = '';
      let detailRefreshInFlight = false;
      let detailDirty = false;
      function filesSignature(files: FileDto[]): string {
        return files
          .map(
            (f) =>
              f.fileUrl +
              '|' +
              (f.downloadState ?? '') +
              '|' +
              Math.round((f.downloadFraction ?? 0) * 100),
          )
          .join(';');
      }
      async function refreshDetailFiles(): Promise<void> {
        const section = document.querySelector('[data-screen="detail"]');
        if (!detailTitle || !section || section.classList.contains('hidden'))
          return;
        // Never clobber an in-flight file click (Agent 40): the
        // click's finally re-invokes this once it settles.
        if (pendingFileClicks.size > 0) {
          detailDirty = true;
          return;
        }
        if (detailRefreshInFlight) {
          detailDirty = true;
          return;
        }
        detailRefreshInFlight = true;
        const gen = detailGen;
        try {
          const detail = await getTitleDetail(detailTitle.folderUrl);
          if (gen !== detailGen) return;
          const sig = filesSignature(detail.files);
          if (sig === detailFilesSig) return;
          detailFilesSig = sig;
          detailTitle = detail.title;
          status('detail-files-heading').textContent =
            'Files · ' + detail.files.length;
          const main = document.querySelector('main');
          const top = main?.scrollTop ?? 0;
          // renderFiles rebuilds the rows: if focus sat on a
          // file button, restore it to the same file's new
          // button afterwards (Agent 40).
          const ae = document.activeElement as HTMLElement | null;
          const focusRow = ae?.closest('[data-file-url]') as
            | HTMLElement
            | null;
          const focusUrl =
            focusRow && status('detail-files').contains(focusRow)
              ? focusRow.dataset.fileUrl
              : undefined;
          renderFiles(detail);
          if (main) main.scrollTop = top;
          if (focusUrl) {
            status('detail-files')
              .querySelector(
                '[data-file-url="' + CSS.escape(focusUrl) + '"] button',
              )
              ?.focus({ preventScroll: true });
          }
        } catch {
          // keep the current paint; the next event retries
        } finally {
          detailRefreshInFlight = false;
          if (detailDirty) {
            detailDirty = false;
            void refreshDetailFiles();
          }
        }
      }

      function paintFav(): void {
        const fav = detailTitle?.isFavorite ?? false;
        status('detail-fav').setAttribute('aria-pressed', String(fav));
        status('detail-fav-icon').replaceChildren(
          icon(fav ? 'star-filled' : 'star', 16),
        );
        status('detail-fav-label').textContent = fav ? 'Favorited' : 'Favorite';
      }

      // Focus path (Agents 31/34): opening Detail moves focus to
      // the title; closing returns it to the card that opened it.
      let detailInvoker: HTMLElement | null = null;
      function closeDetail(): void {
        show('library');
        const invoker = detailInvoker;
        detailInvoker = null;
        if (invoker && document.contains(invoker)) {
          invoker.focus();
        } else {
          (
            document.querySelector(
              '#chips .chip[tabindex="0"]',
            ) as HTMLElement | null
          )?.focus();
        }
      }

      async function openDetail(t: TitleDto): Promise<void> {
        const gen = ++detailGen;
        detailTitle = t;
        detailFilesSig = '';
        if (
          document.activeElement instanceof HTMLElement &&
          document.activeElement !== document.body
        ) {
          detailInvoker = document.activeElement;
        }
        show('detail');
        status('detail-title').focus({ preventScroll: true });
        // Snapshot paint: everything the DTO already knows renders
        // now; only the file list waits for hydration.
        status('detail-title').textContent = t.title;
        status('detail-title').title = t.title;
        const meta = status('detail-meta');
        meta.replaceChildren();
        const chips: string[] = [];
        if (t.year) chips.push(t.year);
        chips.push(t.category, t.sourceName);
        if (t.language) chips.push(t.language);
        if (t.copies > 1) chips.push(t.copies + ' copies');
        for (const c of chips) meta.append(el('span', 'badge-meta', c));
        status('detail-initials').textContent = initials(t.title);
        const poster = status('detail-poster') as HTMLImageElement;
        const wash = status('detail-wash') as HTMLImageElement;
        poster.classList.add('hidden');
        poster.removeAttribute('src');
        wash.classList.add('hidden');
        wash.removeAttribute('src');
        if (t.posterUrl) {
          const [src] = await posterSrcs([t.posterUrl]);
          if (gen === detailGen && src) {
            // Property assignment, not addEventListener: these
            // elements persist across Detail visits and listeners
            // would accumulate (Agent 45).
            poster.onerror = () => poster.classList.add('hidden');
            poster.src = src;
            poster.classList.remove('hidden');
            // The hero wash reuses the same resolved poster src —
            // the frontend never constructs poster URLs (Agent 30).
            wash.onerror = () => wash.classList.add('hidden');
            wash.src = src;
            wash.classList.remove('hidden');
          }
        }
        paintFav();
        status('detail-status').textContent = 'Loading files…';
        status('detail-files-heading').textContent = 'Files';
        status('detail-files').replaceChildren();
        try {
          const detail = await getTitleDetail(t.folderUrl);
          if (gen !== detailGen) return;
          detailTitle = detail.title;
          detailFilesSig = filesSignature(detail.files);
          status('detail-status').textContent = '';
          status('detail-files-heading').textContent =
            'Files · ' + detail.files.length;
          renderFiles(detail);
        } catch {
          if (gen === detailGen) {
            status('detail-status').textContent =
              'Could not load the file list — the server may be unreachable.';
          }
        }
      }

      document
        .getElementById('detail-back')!
        .addEventListener('click', () => closeDetail());
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const detail = document.querySelector('[data-screen="detail"]')!;
        if (!detail.classList.contains('hidden')) closeDetail();
      });
      status('detail-fav').addEventListener('click', async () => {
        if (!detailTitle) return;
        const now = await toggleFavorite(detailTitle.folderUrl);
        detailTitle.isFavorite = now;
        paintFav();
        if (now) {
          const ic = status('detail-fav-icon');
          ic.classList.remove('fav-pop');
          void ic.offsetWidth;
          ic.classList.add('fav-pop');
        }
      });

      // ---- boot ---------------------------------------------------------------
      async function main() {
        let boot: BootstrapDto;
        try {
          boot = await getBootstrap();
        } catch {
          // No backend answered: a static preview, an unreachable
          // web server, or a failed IPC bridge (Agent 30). Say that
          // honestly and offer a real retry — a reload re-runs boot
          // cleanly in both transports.
          showBanner(
            'info',
            'Could not reach the LanFetch backend. If this is a preview, start the desktop app or the web server, then retry.',
            'Retry',
            () => location.reload(),
          );
          return;
        }
        status('version').textContent = 'v' + boot.appVersion;
        status('set-version').textContent = 'Version ' + boot.appVersion;
        status('set-dl-dir').textContent = boot.downloadsDir;
        status('set-data-dir').textContent = boot.dataDir;
        currentSettings = boot.settings;
        sourcesList = boot.sources;
        renderServers();
        sel('set-connections').value = String(boot.settings.connections);
        sel('set-concurrent').value = String(boot.settings.maxConcurrent);
        sel('set-language').value = boot.settings.language;
        // settings.json is the theme's source of truth; localStorage
        // is only the pre-paint cache that mirrors it.
        applyTheme(boot.settings.theme);
        if (!boot.settings.onboardingDone) {
          status('onboarding').classList.remove('hidden');
          const finishOnboarding = async () => {
            status('onboarding').classList.add('hidden');
            await persistSettings({ onboardingDone: true });
          };
          document
            .getElementById('ob-done')!
            .addEventListener('click', () => void finishOnboarding());
          document
            .getElementById('ob-check')!
            .addEventListener('click', () => {
              void finishOnboarding();
              show('servers');
            });
        }
        renderDownloads(boot.downloads);
        void loadProbes();
        void loadLibrary(false);
        void checkUpdate().then((v) => {
          status('set-update').replaceChildren(
            icon(v ? 'arrow-up-circle' : 'check', 16),
            document.createTextNode(
              v
                ? 'LanFetch ' +
                    v +
                    ' is available — download it from the project’s Releases page. Your settings and downloads carry over.'
                : 'You are on the latest version.',
            ),
          );
        });
      }
      void main();
    </script>
  </body>
</html>
