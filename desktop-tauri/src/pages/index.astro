                  <div class="flex items-center gap-2">
                    <dt class="w-28 shrink-0 text-ink-2">App data</dt>
                    <dd class="min-w-0 flex-1 truncate" id="set-data-dir">…</dd>
                    <button class="icon-btn shrink-0" data-copy-target="set-data-dir" aria-label="Copy app data folder path">
                      <svg class="ic ic-16" aria-hidden="true"><use href="#i-copy" /></svg>
