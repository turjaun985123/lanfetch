    <div id="a11y-announcer" class="sr-only" role="status" aria-live="polite"></div>
    <div id="toast-region" class="toast-region"></div>
    <dialog
      id="confirm-dialog"
      class="dialog"
      aria-labelledby="confirm-title"
      aria-describedby="confirm-body"
    >
      <h3 id="confirm-title" class="text-heading font-semibold"></h3>
      <p id="confirm-body" class="mt-1.5 text-body text-ink-2"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button id="confirm-cancel" class="btn btn-ghost btn-sm">Cancel</button>
        <button id="confirm-ok" class="btn btn-danger btn-sm"></button>
      </div>
    </dialog>

    <script>
      import {
        addSource,
        clearCompletedDownloads,
        feedNext,
        feedOpen,
        getBootstrap,
        getCategories,
        getDownloads,
        getTitleDetail,
        onDownloadsChanged,
        pauseDownload,
        posterSrcs,
        probeSources,
        checkUpdate,
        getFavorites,
        pauseAllDownloads,
        redownloadDownload,
        removeDownload,
        removeSource,
        resumeAllDownloads,
        resumeDownload,
        searchTitles,
        setSourceEnabled,
        startDownload,
        toggleFavorite,
        updateSettings,
      } from '../lib/api';
      import type {
        BootstrapDto,
        CategoryDto,
        DownloadListDto,
        FeedPageDto,
        FileDto,
        SettingsDto,
        SourceDto,
        SourceProbeDto,
        TaskDto,
        TitleDetailDto,
        TitleDto,
      } from '../lib/api';
      import {
        STATE_LABEL,
        fmtBytes,
        fmtEta,
        fmtSpeed,
        initials,
      } from '../lib/format';
      import { confirmDialog, el, icon, toast } from '../lib/ui';
      import { createTransfers } from '../lib/transfers';
      import { createServers } from '../lib/servers';
      import { createSettings } from '../lib/settings';
      import { createLibrary } from '../lib/library';
      import { createDetail } from '../lib/detail';

      const status = (id: string) => document.getElementById(id)!;

      // ---- view switching -------------------------------------------------
      function show(view: string) {
        document.querySelectorAll('[data-screen]').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'hidden',
            (el as HTMLElement).dataset.screen !== view,
          );
        });
        // Focus hygiene (Agent 37): if focus sat inside the
        // section just hidden, it would drop to <body> — move it
        // to the target screen's heading instead. Nav clicks are
        // unaffected (focus is on the rail, outside any section).
        const ae = document.activeElement as HTMLElement | null;
        if (ae && ae !== document.body) {
          const sec = ae.closest('[data-screen]') as HTMLElement | null;
          if (sec && sec.dataset.screen !== view) {
            document
              .querySelector(
                '[data-screen="' + view + '"] .page-title',
              )
              ?.focus({ preventScroll: true });
          }
        }
        // The detail screen belongs to the Library tab.
        const navView = view === 'detail' ? 'library' : view;
        document.querySelectorAll('#nav .nav-item').forEach((el) => {
          const active = (el as HTMLElement).dataset.view === navView;
          (el as HTMLElement).classList.toggle('is-active', active);
          if (active) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
      }

      // ---- rail mode (Agents 11-13) -----------------------------------------
      // data-rail on <html> is the single switch for the compact
      // rail; the pre-paint script set it before first render and
      // this keeps it truthful on resize / toggle. Below 768 the
      // bottom-bar media query owns the layout entirely.
      const railToggle = document.getElementById('rail-toggle');
      function applyRail() {
        const w = window.innerWidth;
        let mode = 'expanded';
        let savedRail: string | null = null;
        try {
          savedRail = localStorage.getItem('lanfetch-rail');
        } catch {
          /* storage unavailable */
        }
        if (w >= 768 && w < 1024) mode = 'compact';
        else if (w >= 1024 && savedRail === 'compact') mode = 'compact';
        document.documentElement.dataset.rail = mode;
        if (railToggle) {
          railToggle.setAttribute(
            'aria-expanded',
            mode === 'expanded' ? 'true' : 'false',
          );
          // In the 768–1023 band the compact rail is forced, so
          // the toggle cannot change anything there — disable it
          // rather than letting it silently no-op (Agent 38).
          const forced = w >= 768 && w < 1024;
          (railToggle as HTMLButtonElement).disabled = forced;
          const label = forced
            ? 'Sidebar is compact at this window width'
            : mode === 'expanded'
              ? 'Collapse sidebar'
              : 'Expand sidebar';
          railToggle.setAttribute('aria-label', label);
          railToggle.setAttribute('title', label);
        }
      }
      applyRail();
      window.addEventListener('resize', applyRail);
      railToggle?.addEventListener('click', () => {
        const compact = document.documentElement.dataset.rail !== 'compact';
        try {
          localStorage.setItem(
            'lanfetch-rail',
            compact ? 'compact' : 'expanded',
          );
        } catch {}
        applyRail();
      });
      document.querySelectorAll('#nav .nav-item').forEach((el) => {
        el.addEventListener('click', () =>
          show((el as HTMLElement).dataset.view!),
        );
      });
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        // Never hijack keys while a modal dialog is open (Agent 49).
        if (document.querySelector('dialog[open]')) return;
        const key = e.key.toLowerCase();
        if (key === '1') show('library');
        else if (key === '2') show('transfers');
        else if (key === '3') show('servers');
        else if (key === ',') show('settings');
        else if (key === 'k' || key === 'f') {
          e.preventDefault();
          // Leave Detail through closeDetail so its focus state
          // stays truthful (Agent 49).
          const detail = document.querySelector('[data-screen="detail"]')!;
          if (!detail.classList.contains('hidden')) detailScreen.closeDetail();
          else show('library');
          document.getElementById('lib-search')!.focus();
        }
      });
      show('library');

      // Transfers screen (V2 Wave 4): the implementation lives in
      // src/lib/transfers.ts behind a state factory. The shell
      // keeps these aliases so the Detail/Library/boot call sites
      // below read exactly as before.
      const transfers = createTransfers({
        status,
        onStamp: () => {
          void detailScreen.refreshDetailFiles();
        },
      });
      const renderDownloads = transfers.renderDownloads;
      const refreshDownloads = transfers.refreshDownloads;
      transfers.mount();

      // Servers screen (V2 Wave 4): implementation in
      // src/lib/servers.ts behind a state factory. The probe ->
      // lib-status coupling delegates to the Library screen
      // (created below; the closure runs after boot, when both
      // exist).
      const servers = createServers({
        status,
        libraryStatus: (up) => library.probeStatus(up),
      });
      const renderServers = servers.renderServers;
      const loadProbes = servers.loadProbes;
      servers.mount();

      // Settings screen (V2 Wave 4, theme included): implementation
      // in src/lib/settings.ts behind a state factory. Aliases keep
      // the boot call sites below unchanged.
      const settingsScreen = createSettings({ status });
      const applyTheme = settingsScreen.applyTheme;
      const persistSettings = settingsScreen.persistSettings;
      settingsScreen.mount();

      // Library screen (V2 Wave 4): implementation in
      // src/lib/library.ts behind a state factory. Aliases keep
      // the boot call sites below unchanged; the Servers probe
      // coupling now goes through library.probeStatus.
      const library = createLibrary({
        status,
        show,
        openDetail: (t) => void detailScreen.openDetail(t),
      });
      const loadLibrary = library.loadLibrary;
      const showBanner = library.showBanner;
      library.mount();
      // Detail screen (V2 Wave 4): implementation in
      // src/lib/detail.ts behind a state factory. The Library
      // (above) and the Transfers stamp callback reach it through
      // the factory; both closures run after boot, when it
      // exists.
      const detailScreen = createDetail({ status, show, renderDownloads });
      const openDetail = detailScreen.openDetail;
      detailScreen.mount();

      // ---- boot ---------------------------------------------------------------
      async function main() {
        let boot: BootstrapDto;
        try {
          boot = await getBootstrap();
        } catch {
          // No backend answered: a static preview, an unreachable
          // web server, or a failed IPC bridge (Agent 30). Say that
          // honestly and offer a real retry — a reload re-runs boot
          // cleanly in both transports.
          showBanner(
            'info',
            'Could not reach the LanFetch backend. If this is a preview, start the desktop app or the web server, then retry.',
            'Retry',
            () => location.reload(),
          );
          return;
        }
        status('version').textContent = 'v' + boot.appVersion;
        status('set-version').textContent = 'Version ' + boot.appVersion;
        status('set-dl-dir').textContent = boot.downloadsDir;
        status('set-data-dir').textContent = boot.dataDir;
        settingsScreen.setSettings(boot.settings);
        servers.setSources(boot.sources);
        renderServers();
        settingsScreen.syncSettingsForm(boot.settings);
        // settings.json is the theme's source of truth; localStorage
        // is only the pre-paint cache that mirrors it.
        applyTheme(boot.settings.theme);
        if (!boot.settings.onboardingDone) {
          status('onboarding').classList.remove('hidden');
          const finishOnboarding = async () => {
            status('onboarding').classList.add('hidden');
            await persistSettings({ onboardingDone: true });
          };
          document
            .getElementById('ob-done')!
            .addEventListener('click', () => void finishOnboarding());
          document
            .getElementById('ob-check')!
            .addEventListener('click', () => {
              void finishOnboarding();
              show('servers');
            });
        }
        renderDownloads(boot.downloads);
        void loadProbes();
        void loadLibrary(false);
        void checkUpdate().then((v) => {
          status('set-update').replaceChildren(
            icon(v ? 'arrow-up-circle' : 'check', 16),
            document.createTextNode(
              v
                ? 'LanFetch ' +
                    v +
                    ' is available — download it from the project’s Releases page. Your settings and downloads carry over.'
                : 'You are on the latest version.',
            ),
          );
        });
      }
      void main();
    </script>
  </body>
