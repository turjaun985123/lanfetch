              <a href="#set-sec-updates" class="settings-nav-item" data-sec="set-sec-updates">Updates</a>
              <a href="#set-sec-shortcuts" class="settings-nav-item" data-sec="set-sec-shortcuts">Keyboard shortcuts</a>
