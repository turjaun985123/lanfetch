---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LanFetch</title>
    <script is:inline>
      // Theme before first paint (no flash): stored choice wins,
      // otherwise follow the OS.
      try {
        var t = localStorage.getItem('lanfetch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="flex h-full">
      <!-- Rail -->
      <aside
        class="flex w-52 shrink-0 flex-col border-r border-hairline bg-surface"
      >
        <div class="px-4 pb-2 pt-4 text-[22px] font-semibold tracking-tight">
          lanfetch
        </div>
        <nav
          class="flex flex-col gap-1 px-3 py-2 text-[13px] font-medium"
          id="nav"
        >
          <button data-view="library" class="nav-item">Library</button>
          <button data-view="transfers" class="nav-item">
            Transfers
            <span
              id="nav-badge"
              class="ml-auto hidden min-w-[18px] rounded-full bg-accent px-1 text-center text-[10px] font-semibold text-white"
            ></span>
          </button>
          <button data-view="servers" class="nav-item">Servers</button>
          <button data-view="settings" class="nav-item">Settings</button>
        </nav>
        <div class="mt-auto px-4 pb-1 text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">
          Servers
        </div>
        <div class="px-4 pb-2 text-[12px] text-ink-2" id="rail-servers">…</div>
        <div class="px-4 py-3 text-[11px] text-ink-3" id="version"></div>
      </aside>

      <!-- Content -->
      <main class="min-w-0 flex-1 overflow-y-auto">
        <!-- Library -->
        <section data-screen="library">
          <header class="border-b border-hairline px-6 py-3">
            <div class="flex items-center justify-between gap-3">
              <h1 class="text-[17px] font-semibold">Library</h1>
              <div class="flex items-center gap-2">
                <input
                  id="lib-search"
                  type="text"
                  placeholder="Search titles…"
                  autocomplete="off"
                  class="w-56 rounded-full border border-hairline bg-raised px-3.5 py-1.5 text-[12.5px] text-ink outline-none placeholder:text-ink-3 focus:border-accent"
                />
                <button
                  id="lib-refresh"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Refresh
                </button>
              </div>
            </div>
            <p class="text-[12px] text-ink-2" id="lib-status">…</p>
            <div
              id="chips"
              class="mt-3 flex gap-1.5 overflow-x-auto pb-1"
            ></div>
          </header>
          <div id="onboarding" class="hidden px-6 pt-5">
            <div class="rounded-2xl border border-hairline bg-surface px-5 py-4">
              <p class="text-[15px] font-semibold">Welcome to LanFetch</p>
              <p class="mt-1 max-w-[560px] text-[12.5px] leading-relaxed text-ink-2">
                Your DhakaFlix servers are already set up — no configuration
                needed. Browse the Library, open a title, and download with
                byte-exact resume: pause anything, close the app, and it
                continues where it left off.
              </p>
              <div class="mt-3 flex gap-2">
                <button
                  id="ob-done"
                  class="rounded-full bg-accent px-4 py-1.5 text-[12.5px] font-semibold text-white"
                >
                  Start browsing
                </button>
                <button
                  id="ob-check"
                  class="rounded-full border border-hairline px-4 py-1.5 text-[12.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Check servers first
                </button>
              </div>
            </div>
          </div>
          <div
            id="grid"
            class="grid grid-cols-[repeat(auto-fill,minmax(132px,1fr))] gap-x-4 gap-y-5 px-6 py-5"
          ></div>
          <div id="lib-empty" class="hidden px-6 py-16 text-center">
            <p class="text-[15px] font-semibold">Nothing here yet</p>
            <p class="mx-auto mt-1.5 max-w-[420px] text-[12px] leading-relaxed text-ink-2">
              No titles in this category right now. If the servers just
              came online, Refresh reloads the catalog.
            </p>
          </div>
          <div id="sentinel" class="h-2"></div>
        </section>

        <!-- Detail -->
        <section data-screen="detail" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <button
              id="detail-back"
              class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
            >
              ← Library
            </button>
          </header>
          <div class="flex gap-6 px-6 py-5">
            <div class="w-[180px] shrink-0">
              <div
                class="relative aspect-[2/3] overflow-hidden rounded-xl border border-hairline bg-raised"
              >
                <div
                  id="detail-initials"
                  class="absolute inset-0 flex items-center justify-center text-[34px] font-semibold text-ink-3"
                ></div>
                <img
                  id="detail-poster"
                  class="absolute inset-0 hidden h-full w-full object-cover"
                  draggable="false"
                  alt=""
                />
              </div>
              <button
                id="detail-fav"
                class="mt-3 w-full rounded-full border border-hairline px-3 py-1.5 text-[12.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
              >
                ☆ Favorite
              </button>
            </div>
            <div class="min-w-0 flex-1">
              <h2
                id="detail-title"
                class="text-[20px] font-semibold leading-snug"
              ></h2>
              <p id="detail-meta" class="mt-1 text-[12.5px] text-ink-2"></p>
              <p id="detail-status" class="mt-1 text-[12px] text-ink-3"></p>
              <div id="detail-files" class="mt-4 flex flex-col gap-2"></div>
            </div>
          </div>
        </section>

        <!-- Transfers -->
        <section data-screen="transfers" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <div class="flex items-center justify-between">
              <h1 class="text-[17px] font-semibold">Transfers</h1>
              <div class="flex gap-1.5">
                <button
                  id="tr-pause-all"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Pause all
                </button>
                <button
                  id="tr-resume-all"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Resume all
                </button>
                <button
                  id="tr-clear"
                  class="rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised"
                >
                  Clear completed
                </button>
              </div>
            </div>
            <p class="text-[12px] text-ink-2" id="tr-status">…</p>
          </header>
          <div class="flex flex-col gap-2.5 px-6 py-5" id="tasks"></div>
        </section>

        <!-- Servers -->
        <section data-screen="servers" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <h1 class="text-[17px] font-semibold">Servers</h1>
            <p class="text-[12px] text-ink-2" id="srv-status">…</p>
          </header>
          <div class="px-6 pt-5">
            <div
              class="flex flex-wrap items-center gap-2 rounded-2xl border border-hairline bg-surface px-4 py-3"
            >
              <input
                id="srv-name"
                type="text"
                placeholder="Server name"
                autocomplete="off"
                class="w-40 rounded-full border border-hairline bg-raised px-3 py-1.5 text-[12.5px] text-ink outline-none placeholder:text-ink-3 focus:border-accent"
              />
              <input
                id="srv-url"
                type="text"
                placeholder="http://192.168.1.10/movies/"
                autocomplete="off"
                class="min-w-56 flex-1 rounded-full border border-hairline bg-raised px-3 py-1.5 text-[12.5px] text-ink outline-none placeholder:text-ink-3 focus:border-accent"
              />
              <button
                id="srv-add"
                class="rounded-full bg-accent px-4 py-1.5 text-[12.5px] font-semibold text-white"
              >
                Add server
              </button>
              <p id="srv-error" class="w-full text-[12px] text-failed"></p>
            </div>
          </div>
          <div class="flex flex-col gap-2 px-6 py-5" id="probes"></div>
        </section>

        <!-- Settings -->
        <section data-screen="settings" class="hidden">
          <header class="border-b border-hairline px-6 py-3">
            <h1 class="text-[17px] font-semibold">Settings</h1>
            <p class="text-[12px] text-ink-2">Applies immediately — no Save button.</p>
          </header>
          <div class="flex max-w-[560px] flex-col gap-6 px-6 py-5">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Appearance</p>
              <div class="mt-2 flex gap-1 rounded-full bg-raised p-1" id="theme-switch">
                <button data-theme-choice="system" class="theme-btn">System</button>
                <button data-theme-choice="light" class="theme-btn">Light</button>
                <button data-theme-choice="dark" class="theme-btn">Dark</button>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Download engine</p>
              <div class="mt-2 flex flex-col gap-2.5 text-[13px]">
                <label class="flex items-center gap-3">
                  <span class="w-44 shrink-0 text-ink-2">Connections per file</span>
                  <select id="set-connections" class="rounded-lg border border-hairline bg-raised px-2 py-1.5 text-ink">
                    <option>1</option><option>2</option><option>4</option><option>6</option>
                    <option>8</option><option>12</option><option>16</option><option>24</option><option>32</option>
                  </select>
                </label>
                <label class="flex items-center gap-3">
                  <span class="w-44 shrink-0 text-ink-2">Downloads at once</span>
                  <select id="set-concurrent" class="rounded-lg border border-hairline bg-raised px-2 py-1.5 text-ink">
                    <option>1</option><option>2</option><option>3</option><option>4</option>
                    <option>6</option><option>8</option><option>12</option><option>16</option>
                  </select>
                </label>
                <label class="flex items-center gap-3">
                  <span class="w-44 shrink-0 text-ink-2">Language</span>
                  <select id="set-language" class="rounded-lg border border-hairline bg-raised px-2 py-1.5 text-ink">
                    <option value="system">System</option>
                    <option value="en">English</option>
                    <option value="bn">বাংলা</option>
                  </select>
                </label>
                <p class="text-[12px] text-ink-3">
                  Engine values apply to new downloads immediately. The
                  language choice is saved now and translates the whole
                  interface in the polish update.
                </p>
              </div>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Storage</p>
              <dl class="mt-2 flex flex-col gap-1.5 text-[13px]">
                <div class="flex gap-2"><dt class="w-28 shrink-0 text-ink-2">Downloads</dt><dd class="min-w-0 truncate" id="set-dl-dir">…</dd></div>
                <div class="flex gap-2"><dt class="w-28 shrink-0 text-ink-2">App data</dt><dd class="min-w-0 truncate" id="set-data-dir">…</dd></div>
              </dl>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3">Updates</p>
              <p id="set-update" class="mt-2 text-[13px] text-ink-2">Checking…</p>
            </div>
          </div>
        </section>
      </main>
    </div>

    <style>
      @reference "../styles/global.css";
      .nav-item {
        @apply flex items-center rounded-full px-4 py-2 text-left text-ink-2 transition-colors duration-150;
      }
      .nav-item:hover {
        @apply bg-raised;
      }
      .nav-item.is-active {
        @apply bg-accent-container text-on-accent-container;
      }
      .theme-btn {
        @apply flex-1 rounded-full px-3 py-1.5 text-[12.5px] font-medium text-ink-2 transition-colors duration-150;
      }
      .theme-btn.is-active {
        @apply bg-surface text-ink shadow-sm;
      }
      .chip {
        @apply shrink-0 rounded-full border border-hairline px-3 py-1 text-[12px] font-medium text-ink-2 transition-colors duration-150;
      }
      .chip:hover {
        @apply bg-raised;
      }
      .chip.is-active {
        @apply border-transparent bg-accent-container text-on-accent-container;
      }
    </style>

    <script>
      import { listen } from '@tauri-apps/api/event';
      import {
        addSource,
        clearCompletedDownloads,
        feedNext,
        feedOpen,
        getBootstrap,
        getCategories,
        getDownloads,
        getTitleDetail,
        pauseDownload,
        posterSrcs,
        probeSources,
        checkUpdate,
        getFavorites,
        pauseAllDownloads,
        redownloadDownload,
        removeDownload,
        removeSource,
        resumeAllDownloads,
        resumeDownload,
        searchTitles,
        setSourceEnabled,
        startDownload,
        toggleFavorite,
        updateSettings,
      } from '../lib/api';
      import type {
        BootstrapDto,
        CategoryDto,
        DownloadListDto,
        FeedPageDto,
        FileDto,
        SettingsDto,
        SourceDto,
        SourceProbeDto,
        TaskDto,
        TitleDetailDto,
        TitleDto,
      } from '../lib/api';

      const status = (id: string) => document.getElementById(id)!;

      // ---- view switching -------------------------------------------------
      function show(view: string) {
        document.querySelectorAll('[data-screen]').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'hidden',
            (el as HTMLElement).dataset.screen !== view,
          );
        });
        // The detail screen belongs to the Library tab.
        const navView = view === 'detail' ? 'library' : view;
        document.querySelectorAll('#nav .nav-item').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'is-active',
            (el as HTMLElement).dataset.view === navView,
          );
        });
      }
      document.querySelectorAll('#nav .nav-item').forEach((el) => {
        el.addEventListener('click', () =>
          show((el as HTMLElement).dataset.view!),
        );
      });
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        if (e.key === '1') show('library');
        else if (e.key === '2') show('transfers');
        else if (e.key === '3') show('servers');
        else if (e.key === ',') show('settings');
        else if (e.key === 'k' || e.key === 'f') {
          e.preventDefault();
          show('library');
          document.getElementById('lib-search')!.focus();
        }
      });
      show('library');

      // ---- formatting ------------------------------------------------------
      function fmtBytes(n: number): string {
        if (n <= 0) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        let i = 0;
        let v = n;
        while (v >= 1024 && i < units.length - 1) {
          v /= 1024;
          i++;
        }
        return (v >= 100 ? Math.round(v) : v.toFixed(1)) + ' ' + units[i];
      }
      const STATE_LABEL: Record<TaskDto['state'], string> = {
        queued: 'Queued',
        running: 'Running',
        paused: 'Paused',
        completed: 'Completed',
        failed: 'Failed',
      };
      function fmtSpeed(bps: number): string {
        return bps > 0 ? fmtBytes(Math.round(bps)) + '/s' : '';
      }
      function fmtEta(secs: number | null): string {
        if (secs == null || !isFinite(secs) || secs < 0) return '';
        const s = Math.round(secs);
        if (s < 60) return s + 's left';
        if (s < 3600) return Math.floor(s / 60) + 'm ' + (s % 60) + 's left';
        return Math.floor(s / 3600) + 'h ' + Math.floor((s % 3600) / 60) + 'm left';
      }

      function renderDownloads(list: DownloadListDto) {
        if (list.stamp > lastStamp) lastStamp = list.stamp;
        const wrap = status('tasks');
        const tasks = list.tasks;
        status('tr-status').textContent =
          tasks.length === 0
            ? 'No transfers yet'
            : tasks.length + ' transfers · ' + list.activeCount + ' active';
        const badge = status('nav-badge');
        if (list.activeCount > 0) {
          badge.textContent = String(list.activeCount);
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
        wrap.replaceChildren();
        if (tasks.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'py-10 text-center text-[13px] text-ink-2';
          empty.textContent =
            'Movies and episodes you download appear here with live progress and speed.';
          wrap.append(empty);
          return;
        }
        for (const t of tasks) {
          const card = document.createElement('div');
          card.className =
            'rounded-2xl border border-hairline bg-surface px-4 py-3.5';
          const top = document.createElement('div');
          top.className = 'flex items-baseline gap-3';
          const name = document.createElement('span');
          name.className = 'min-w-0 flex-1 truncate text-[13.5px] font-medium';
          name.textContent = t.name;
          const state = document.createElement('span');
          state.className = 'text-[12px] font-medium text-ink-2';
          state.textContent =
            STATE_LABEL[t.state] +
            (t.state === 'running' || t.state === 'paused'
              ? ' · ' + Math.round(t.fraction * 100) + '%'
              : '');
          top.append(name, state);
          const bar = document.createElement('div');
          bar.className = 'mt-2.5 h-1.5 overflow-hidden rounded-full bg-raised';
          const fill = document.createElement('div');
          fill.className =
            'h-full rounded-full ' +
            (t.state === 'failed'
              ? 'bg-failed'
              : t.state === 'completed'
                ? 'bg-done'
                : t.state === 'paused'
                  ? 'bg-paused'
                  : 'bg-accent');
          fill.style.width = Math.round(t.fraction * 100) + '%';
          bar.append(fill);
          const meta = document.createElement('p');
          meta.className = 'mt-2 text-[12px] tabular-nums text-ink-3';
          meta.textContent =
            fmtBytes(t.downloaded) +
            (t.total > 0 ? ' of ' + fmtBytes(t.total) : '') +
            (t.state === 'running' && t.speedBps > 0
              ? ' · ' + fmtSpeed(t.speedBps)
              : '') +
            (t.state === 'running' && fmtEta(t.etaSecs)
              ? ' · ' + fmtEta(t.etaSecs)
              : '') +
            (t.error ? ' · ' + t.error : '');
          card.append(top, bar, meta);
          const actions = document.createElement('div');
          actions.className = 'mt-2.5 flex gap-1.5';
          const mkBtn = (label: string, fn: () => Promise<DownloadListDto>) => {
            const b = document.createElement('button');
            b.className =
              'rounded-full border border-hairline px-3 py-1 text-[11.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised';
            b.textContent = label;
            b.addEventListener('click', async () => {
              b.disabled = true;
              try {
                renderDownloads(await fn());
              } catch {
                b.disabled = false;
              }
            });
            return b;
          };
          if (t.state === 'running' || t.state === 'queued') {
            actions.append(mkBtn('Pause', () => pauseDownload(t.id)));
          }
          if (t.state === 'paused') {
            actions.append(mkBtn('Resume', () => resumeDownload(t.id)));
          }
          if (t.state === 'failed') {
            actions.append(mkBtn('Retry', () => resumeDownload(t.id)));
          }
          if (t.state === 'completed' && t.fileMissing) {
            const note = document.createElement('span');
            note.className = 'self-center text-[11.5px] text-paused';
            note.textContent = 'File missing';
            actions.append(
              note,
              mkBtn('Redownload', () => redownloadDownload(t.id)),
            );
          }
          actions.append(mkBtn('Remove', () => removeDownload(t.id)));
          card.append(actions);
          wrap.append(card);
        }
      }

      // ---- live transfers: pushed, never polled --------------------------------
      let lastStamp = 0;
      let dlFetching = false;
      let dlDirty = false;
      async function refreshDownloads(): Promise<void> {
        if (dlFetching) {
          dlDirty = true;
          return;
        }
        dlFetching = true;
        try {
          const list = await getDownloads();
          if (list.stamp >= lastStamp) {
            lastStamp = list.stamp;
            renderDownloads(list);
          }
        } catch {
          // Not in Tauri (browser preview) or a transient IPC error:
          // the next event retries.
        } finally {
          dlFetching = false;
          if (dlDirty) {
            dlDirty = false;
            void refreshDownloads();
          }
        }
      }
      void listen<number>('downloads-changed', (e) => {
        if (e.payload > lastStamp) void refreshDownloads();
      });
      document
        .getElementById('tr-clear')!
        .addEventListener('click', async () => {
          try {
            renderDownloads(await clearCompletedDownloads());
          } catch {}
        });
      document
        .getElementById('tr-pause-all')!
        .addEventListener('click', async () => {
          try {
            renderDownloads(await pauseAllDownloads());
          } catch {}
        });
      document
        .getElementById('tr-resume-all')!
        .addEventListener('click', async () => {
          try {
            renderDownloads(await resumeAllDownloads());
          } catch {}
        });

      // ---- servers ----------------------------------------------------------
      let sourcesList: SourceDto[] = [];
      const probeMap = new Map<string, SourceProbeDto>();
      function dotClass(s: string | undefined): string {
        return s === 'up' ? 'bg-done' : s === 'down' ? 'bg-failed' : 'bg-ink-3';
      }
      function renderServers(): void {
        const wrap = status('probes');
        wrap.replaceChildren();
        for (const s of sourcesList) {
          const p = probeMap.get(s.name);
          const row = document.createElement('div');
          row.className =
            'flex items-center gap-3 rounded-2xl border border-hairline bg-surface px-4 py-3';
          const dot = document.createElement('span');
          dot.className =
            'h-2 w-2 shrink-0 rounded-full ' + dotClass(p?.status);
          const name = document.createElement('span');
          name.className = 'text-[13.5px] font-medium';
          name.textContent = s.name;
          const url = document.createElement('span');
          url.className = 'min-w-0 flex-1 truncate text-[12px] text-ink-3';
          url.textContent = s.rootUrl;
          const state = document.createElement('span');
          state.className = 'text-[12px] tabular-nums text-ink-2';
          state.textContent = !s.enabled
            ? 'Disabled'
            : p?.status === 'up'
              ? 'Online · ' + p.latencyMs + ' ms'
              : p?.status === 'down'
                ? 'Unreachable'
                : '…';
          const toggle = document.createElement('input');
          toggle.type = 'checkbox';
          toggle.checked = s.enabled;
          toggle.className = 'h-4 w-4 shrink-0 accent-[var(--color-accent)]';
          toggle.title = s.enabled ? 'Disable server' : 'Enable server';
          toggle.addEventListener('change', async () => {
            try {
              sourcesList = await setSourceEnabled(s.name, toggle.checked);
              renderServers();
              void loadProbes();
            } catch {
              toggle.checked = !toggle.checked;
            }
          });
          row.append(dot, name, url, state, toggle);
          if (s.custom) {
            const rm = document.createElement('button');
            rm.className =
              'shrink-0 rounded-full border border-hairline px-2.5 py-1 text-[11.5px] font-medium text-ink-2 transition-colors duration-150 hover:bg-raised';
            rm.textContent = 'Remove';
            rm.addEventListener('click', async () => {
              try {
                sourcesList = await removeSource(s.name);
                probeMap.delete(s.name);
                renderServers();
                void loadProbes();
              } catch (e) {
                status('srv-error').textContent = String(e);
              }
            });
            row.append(rm);
          }
          wrap.append(row);
        }
      }
      async function loadProbes() {
        const results = await probeSources();
        probeMap.clear();
        for (const p of results) probeMap.set(p.name, p);
        renderServers();
        const up = results.filter((r) => r.status === 'up').length;
        status('srv-status').textContent =
          up + ' of ' + results.length + ' servers online';
        status('rail-servers').textContent = up + ' online';
        if (titleCount === 0 && activeQuery === '') {
          status('lib-status').textContent =
            up > 0
              ? up + ' servers online'
              : 'No servers reachable — check the Servers tab';
        }
      }
      document
        .getElementById('srv-add')!
        .addEventListener('click', async () => {
          const nameEl = document.getElementById('srv-name') as HTMLInputElement;
          const urlEl = document.getElementById('srv-url') as HTMLInputElement;
          status('srv-error').textContent = '';
          try {
            sourcesList = await addSource(nameEl.value, urlEl.value);
            nameEl.value = '';
            urlEl.value = '';
            renderServers();
            void loadProbes();
          } catch (e) {
            status('srv-error').textContent = String(e);
          }
        });

      // ---- theme -------------------------------------------------------------
      function applyTheme(choice: string) {
        localStorage.setItem('lanfetch-theme', choice);
        const dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelectorAll('.theme-btn').forEach((el) => {
          (el as HTMLElement).classList.toggle(
            'is-active',
            (el as HTMLElement).dataset.themeChoice === choice,
          );
        });
      }
      document.querySelectorAll('.theme-btn').forEach((el) => {
        el.addEventListener('click', () => {
          const choice = (el as HTMLElement).dataset.themeChoice!;
          applyTheme(choice);
          void persistSettings({ theme: choice });
        });
      });
      applyTheme(localStorage.getItem('lanfetch-theme') ?? 'system');

      // ---- settings ---------------------------------------------------------------
      let currentSettings: SettingsDto | null = null;
      async function persistSettings(
        patch: Partial<SettingsDto>,
      ): Promise<void> {
        if (!currentSettings) return;
        try {
          currentSettings = await updateSettings({
            ...currentSettings,
            ...patch,
          });
        } catch {
          // Browser preview or IPC failure: the local UI state the
          // user just set stays as they left it.
        }
      }
      const sel = (id: string) =>
        document.getElementById(id) as HTMLSelectElement;
      sel('set-connections').addEventListener('change', () =>
        void persistSettings({
          connections: parseInt(sel('set-connections').value, 10),
        }),
      );
      sel('set-concurrent').addEventListener('change', () =>
        void persistSettings({
          maxConcurrent: parseInt(sel('set-concurrent').value, 10),
        }),
      );
      sel('set-language').addEventListener('change', () =>
        void persistSettings({ language: sel('set-language').value }),
      );

      // ---- library feed -------------------------------------------------------
      // The UX laws this implements (the Rune build broke all three):
      // a click takes effect immediately, a newer load supersedes an
      // older one via generation numbers on BOTH sides, and stale
      // results never paint.
      let libGen = 0;
      let feedGen = 0;
      let feedHasMore = false;
      let pageLoading = false;
      let currentCategory: string | null = null;
      let titleCount = 0;

      function initials(name: string): string {
        return name
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((w) => w[0]!.toUpperCase())
          .join('');
      }

      function makeCard(t: TitleDto, posterSrc: string | null): HTMLElement {
        const card = document.createElement('div');
        card.className = 'cursor-pointer';
        const frame = document.createElement('div');
        frame.className =
          'relative aspect-[2/3] overflow-hidden rounded-xl border border-hairline bg-raised';
        const fallback = document.createElement('div');
        fallback.className =
          'absolute inset-0 flex items-center justify-center text-[26px] font-semibold text-ink-3';
        fallback.textContent = initials(t.title);
        frame.append(fallback);
        if (posterSrc) {
          const img = document.createElement('img');
          img.className = 'absolute inset-0 h-full w-full object-cover';
          img.loading = 'lazy';
          img.draggable = false;
          img.alt = '';
          img.src = posterSrc;
          // A failed poster reveals the initials tile underneath —
          // and because failures are not remembered server-side, the
          // next visit can still succeed.
          img.addEventListener('error', () => img.remove());
          frame.append(img);
        }
        const badgeText =
          t.kind === 'series'
            ? t.seasonCount > 1
              ? t.seasonCount + ' Seasons'
              : 'Series'
            : t.bestQuality;
        if (badgeText) {
          const badge = document.createElement('span');
          badge.className =
            'absolute bottom-1.5 left-1.5 rounded-md bg-black/60 px-1.5 py-0.5 text-[10px] font-semibold text-white';
          badge.textContent = badgeText;
          frame.append(badge);
        }
        if (t.isFavorite) {
          const fav = document.createElement('span');
          fav.className =
            'absolute right-1.5 top-1.5 rounded-md bg-black/60 px-1.5 py-0.5 text-[10px] font-semibold text-white';
          fav.textContent = '★';
          frame.append(fav);
        }
        const name = document.createElement('p');
        name.className =
          'mt-2 line-clamp-2 text-[12.5px] font-medium leading-snug';
        name.textContent = t.title;
        const meta = document.createElement('p');
        meta.className = 'mt-0.5 text-[11px] tabular-nums text-ink-3';
        meta.textContent =
          (t.year ? t.year + ' · ' : '') +
          t.sourceName +
          (t.copies > 1 ? ' · ' + t.copies + ' copies' : '');
        card.append(frame, name, meta);
        card.addEventListener('click', () => void openDetail(t));
        return card;
      }

      /** Paint titles into the grid (poster batch first). Returns
       * false when the generation was superseded mid-paint — the
       * caller then drops everything. */
      async function paintTitles(
        titles: TitleDto[],
        gen: number,
        first: boolean,
      ): Promise<boolean> {
        const grid = status('grid');
        if (first) grid.replaceChildren();
        const withPosters = titles.filter((t) => t.posterUrl);
        const srcByUrl = new Map<string, string>();
        if (withPosters.length > 0) {
          const srcs = await posterSrcs(
            withPosters.map((t) => t.posterUrl!),
          );
          if (gen !== libGen) return false; // superseded while registering
          withPosters.forEach((t, i) => srcByUrl.set(t.posterUrl!, srcs[i]!));
        }
        for (const t of titles) {
          grid.append(
            makeCard(t, t.posterUrl ? (srcByUrl.get(t.posterUrl) ?? null) : null),
          );
        }
        return true;
      }

      async function appendPage(
        page: FeedPageDto,
        gen: number,
        first: boolean,
      ): Promise<void> {
        feedHasMore = page.hasMore;
        if (!(await paintTitles(page.titles, gen, first))) return;
        titleCount += page.titles.length;
        status('lib-status').textContent =
          titleCount + ' titles' + (feedHasMore ? ' · scroll for more' : '');
        status('lib-empty').classList.toggle(
          'hidden',
          !(titleCount === 0 && !pageLoading),
        );
      }

      async function openFeed(): Promise<void> {
        const gen = ++libGen;
        activeQuery = '';
        favoritesActive = false;
        titleCount = 0;
        pageLoading = true;
        const grid = status('grid');
        grid.replaceChildren();
        for (let i = 0; i < 12; i++) {
          const sk = document.createElement('div');
          sk.className =
            'aspect-[2/3] animate-pulse rounded-xl border border-hairline bg-raised';
          grid.append(sk);
        }
        status('lib-empty').classList.add('hidden');
        status('lib-status').textContent = 'Loading…';
        try {
          const page = await feedOpen(currentCategory);
          if (gen !== libGen || page.superseded) return;
          feedGen = page.generation;
          await appendPage(page, gen, true);
        } catch {
          if (gen === libGen) {
            grid.replaceChildren();
            status('lib-status').textContent =
              'Could not load the catalog — are the servers reachable?';
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      async function loadMore(): Promise<void> {
        if (pageLoading || !feedHasMore) return;
        pageLoading = true;
        const gen = libGen;
        try {
          const page = await feedNext(feedGen);
          if (gen !== libGen || page.superseded) return;
          await appendPage(page, gen, false);
        } catch {
          // A failed page is not fatal: the sentinel will retry on
          // the next scroll pass.
        } finally {
          pageLoading = false;
        }
      }

      let favoritesActive = false;
      async function openFavorites(): Promise<void> {
        const gen = ++libGen;
        favoritesActive = true;
        activeQuery = '';
        feedHasMore = false;
        titleCount = 0;
        pageLoading = true;
        status('grid').replaceChildren();
        status('lib-empty').classList.add('hidden');
        status('lib-status').textContent = 'Loading favorites…';
        try {
          const favs = await getFavorites();
          if (gen !== libGen) return;
          if (!(await paintTitles(favs, gen, true))) return;
          titleCount = favs.length;
          status('lib-status').textContent = favs.length + ' favorites';
          status('lib-empty').classList.toggle('hidden', favs.length !== 0);
        } catch {
          if (gen === libGen) {
            status('lib-status').textContent = 'Could not load favorites.';
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }

      function renderChips(categories: CategoryDto[]): void {
        const wrap = status('chips');
        wrap.replaceChildren();
        const activate = (b: HTMLElement) => {
          wrap.querySelectorAll('.chip').forEach((el) => {
            el.classList.toggle('is-active', el === b);
          });
        };
        const mk = (label: string, value: string | null) => {
          const b = document.createElement('button');
          b.className =
            'chip' +
            (currentCategory === value && !favoritesActive ? ' is-active' : '');
          b.textContent = label;
          b.addEventListener('click', () => {
            if (currentCategory === value && !favoritesActive) return;
            currentCategory = value;
            favoritesActive = false;
            activate(b);
            void openFeed();
          });
          return b;
        };
        wrap.append(mk('All', null));
        const favChip = document.createElement('button');
        favChip.className = 'chip' + (favoritesActive ? ' is-active' : '');
        favChip.textContent = '★ Favorites';
        favChip.addEventListener('click', () => {
          if (favoritesActive) return;
          activate(favChip);
          void openFavorites();
        });
        wrap.append(favChip);
        for (const c of categories) wrap.append(mk(c.name, c.name));
      }

      async function loadLibrary(refresh: boolean): Promise<void> {
        try {
          const categories = await getCategories(refresh);
          if (categories.length === 0) {
            status('lib-status').textContent =
              'No categories found — check the Servers tab';
            return;
          }
          renderChips(categories);
          void openFeed();
        } catch {
          status('lib-status').textContent =
            'Could not load categories — are the servers reachable?';
        }
      }

      document
        .getElementById('lib-refresh')!
        .addEventListener('click', () => void loadLibrary(true));

      new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) void loadMore();
        },
        { rootMargin: '600px' },
      ).observe(status('sentinel'));

      // ---- search ---------------------------------------------------------------
      // Search and the feed share one generation counter: whichever
      // starts last owns the grid, and the loser's results are
      // dropped even if they arrive later.
      let searchTimer: number | undefined;
      let activeQuery = '';
      async function runSearch(q: string): Promise<void> {
        const gen = ++libGen;
        activeQuery = q;
        favoritesActive = false;
        feedHasMore = false;
        titleCount = 0;
        pageLoading = true;
        const grid = status('grid');
        grid.replaceChildren();
        for (let i = 0; i < 12; i++) {
          const sk = document.createElement('div');
          sk.className =
            'aspect-[2/3] animate-pulse rounded-xl border border-hairline bg-raised';
          grid.append(sk);
        }
        status('lib-empty').classList.add('hidden');
        status('lib-status').textContent = 'Searching…';
        try {
          const results = await searchTitles(q);
          if (gen !== libGen) return;
          if (!(await paintTitles(results, gen, true))) return;
          titleCount = results.length;
          status('lib-status').textContent =
            results.length + ' results for “' + q + '”';
          status('lib-empty').classList.toggle('hidden', results.length !== 0);
        } catch {
          if (gen === libGen) {
            status('lib-status').textContent =
              'Search failed — are the servers reachable?';
          }
        } finally {
          if (gen === libGen) pageLoading = false;
        }
      }
      const searchInput = document.getElementById(
        'lib-search',
      ) as HTMLInputElement;
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim();
        window.clearTimeout(searchTimer);
        if (q.length === 0) {
          if (activeQuery !== '') void openFeed();
          return;
        }
        searchTimer = window.setTimeout(() => void runSearch(q), 300);
      });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const q = searchInput.value.trim();
          window.clearTimeout(searchTimer);
          if (q) void runSearch(q);
        } else if (e.key === 'Escape') {
          searchInput.value = '';
          if (activeQuery !== '') void openFeed();
        }
      });

      // ---- title detail ---------------------------------------------------------
      let detailGen = 0;
      let detailTitle: TitleDto | null = null;

      function fileButton(f: FileDto): HTMLButtonElement {
        const b = document.createElement('button');
        b.className =
          'shrink-0 rounded-full bg-accent px-3.5 py-1.5 text-[12px] font-semibold text-white transition-opacity duration-150 disabled:opacity-60';
        const label = () => {
          switch (f.downloadState) {
            case 'queued':
              b.textContent = 'Queued';
              b.disabled = true;
              break;
            case 'running':
              b.textContent =
                'Downloading ' +
                Math.round((f.downloadFraction ?? 0) * 100) +
                '%';
              b.disabled = true;
              break;
            case 'paused':
              b.textContent = 'Paused';
              b.disabled = true;
              break;
            case 'completed':
              b.textContent = 'Downloaded';
              b.disabled = true;
              break;
            case 'failed':
              b.textContent = 'Retry';
              b.disabled = false;
              break;
            default:
              b.textContent = 'Download';
              b.disabled = false;
          }
        };
        label();
        b.addEventListener('click', async () => {
          b.disabled = true;
          b.textContent = 'Queueing…';
          try {
            const list = await startDownload(f.fileUrl, f.fileName);
            renderDownloads(list);
            f.downloadState = 'queued';
            label();
          } catch {
            b.textContent = 'Download';
            b.disabled = false;
          }
        });
        return b;
      }

      function renderFiles(detail: TitleDetailDto): void {
        const wrap = status('detail-files');
        wrap.replaceChildren();
        if (detail.files.length === 0) {
          const p = document.createElement('p');
          p.className = 'text-[13px] text-ink-2';
          p.textContent = 'No downloadable files in this folder.';
          wrap.append(p);
          return;
        }
        const isSeries = detail.title.kind === 'series';
        const seasons = new Map<number, FileDto[]>();
        for (const f of detail.files) {
          const key = isSeries ? (f.season ?? 0) : 0;
          const arr = seasons.get(key) ?? [];
          arr.push(f);
          seasons.set(key, arr);
        }
        for (const season of [...seasons.keys()].sort((a, b) => a - b)) {
          if (isSeries) {
            const h = document.createElement('p');
            h.className =
              'mt-2 text-[11px] font-semibold uppercase tracking-[0.9px] text-ink-3';
            h.textContent = season > 0 ? 'Season ' + season : 'Episodes';
            wrap.append(h);
          }
          for (const f of seasons.get(season)!) {
            const row = document.createElement('div');
            row.className =
              'flex items-center gap-3 rounded-xl border border-hairline bg-surface px-3.5 py-2.5';
            const text = document.createElement('div');
            text.className = 'min-w-0 flex-1';
            const name = document.createElement('p');
            name.className = 'truncate text-[13px] font-medium';
            name.textContent = f.fileName;
            const sub = document.createElement('p');
            sub.className = 'mt-0.5 text-[11.5px] tabular-nums text-ink-3';
            sub.textContent =
              (f.episode != null ? 'E' + f.episode + ' · ' : '') +
              (f.size >= 0 ? fmtBytes(f.size) : 'Size unknown') +
              (f.quality ? ' · ' + f.quality : '') +
              (f.codec ? ' · ' + f.codec : '') +
              (f.audio ? ' · ' + f.audio : '');
            text.append(name, sub);
            row.append(text, fileButton(f));
            wrap.append(row);
          }
        }
      }

      async function openDetail(t: TitleDto): Promise<void> {
        const gen = ++detailGen;
        detailTitle = t;
        show('detail');
        // Snapshot paint: everything the DTO already knows renders
        // now; only the file list waits for hydration.
        status('detail-title').textContent = t.title;
        status('detail-meta').textContent =
          (t.year ? t.year + ' · ' : '') +
          t.category +
          ' · ' +
          t.sourceName +
          (t.language ? ' · ' + t.language : '') +
          (t.copies > 1 ? ' · ' + t.copies + ' copies' : '');
        status('detail-initials').textContent = initials(t.title);
        const poster = status('detail-poster') as HTMLImageElement;
        poster.classList.add('hidden');
        poster.removeAttribute('src');
        if (t.posterUrl) {
          const [src] = await posterSrcs([t.posterUrl]);
          if (gen === detailGen && src) {
            poster.src = src;
            poster.classList.remove('hidden');
            poster.addEventListener('error', () => poster.classList.add('hidden'), {
              once: true,
            });
          }
        }
        const fav = status('detail-fav');
        fav.textContent = t.isFavorite ? '★ Favorited' : '☆ Favorite';
        status('detail-status').textContent = 'Loading files…';
        status('detail-files').replaceChildren();
        try {
          const detail = await getTitleDetail(t.folderUrl);
          if (gen !== detailGen) return;
          detailTitle = detail.title;
          status('detail-status').textContent =
            detail.files.length + ' files · click Download to start';
          renderFiles(detail);
        } catch {
          if (gen === detailGen) {
            status('detail-status').textContent =
              'Could not load the file list — the server may be unreachable.';
          }
        }
      }

      document
        .getElementById('detail-back')!
        .addEventListener('click', () => show('library'));
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const detail = document.querySelector('[data-screen="detail"]')!;
        if (!detail.classList.contains('hidden')) show('library');
      });
      status('detail-fav').addEventListener('click', async () => {
        if (!detailTitle) return;
        const now = await toggleFavorite(detailTitle.folderUrl);
        detailTitle.isFavorite = now;
        status('detail-fav').textContent = now ? '★ Favorited' : '☆ Favorite';
      });

      // ---- boot ---------------------------------------------------------------
      async function main() {
        let boot: BootstrapDto;
        try {
          boot = await getBootstrap();
        } catch {
          status('lib-status').textContent =
            'Not running inside Tauri — this is the browser preview.';
          return;
        }
        status('version').textContent = 'v' + boot.appVersion;
        status('set-dl-dir').textContent = boot.downloadsDir;
        status('set-data-dir').textContent = boot.dataDir;
        currentSettings = boot.settings;
        sourcesList = boot.sources;
        renderServers();
        sel('set-connections').value = String(boot.settings.connections);
        sel('set-concurrent').value = String(boot.settings.maxConcurrent);
        sel('set-language').value = boot.settings.language;
        // settings.json is the theme's source of truth; localStorage
        // is only the pre-paint cache that mirrors it.
        applyTheme(boot.settings.theme);
        if (!boot.settings.onboardingDone) {
          status('onboarding').classList.remove('hidden');
          const finishOnboarding = async () => {
            status('onboarding').classList.add('hidden');
            await persistSettings({ onboardingDone: true });
          };
          document
            .getElementById('ob-done')!
            .addEventListener('click', () => void finishOnboarding());
          document
            .getElementById('ob-check')!
            .addEventListener('click', () => {
              void finishOnboarding();
              show('servers');
            });
        }
        renderDownloads(boot.downloads);
        void loadProbes();
        void loadLibrary(false);
        void checkUpdate().then((v) => {
          status('set-update').textContent = v
            ? 'LanFetch ' +
              v +
              ' is available — download it from the project’s Releases page. Your settings and downloads carry over.'
            : 'You are on the latest version.';
        });
      }
      void main();
    </script>
  </body>
</html>
