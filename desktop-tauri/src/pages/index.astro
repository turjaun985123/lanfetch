              <section class="card p-4" id="set-sec-updates">
                <h2 class="text-heading font-semibold">Updates</h2>
                <p class="mt-0.5 text-secondary text-ink-2" id="set-version">Version …</p>
                <p id="set-update" class="mt-2 flex items-center gap-2 text-body text-ink-2" role="status">Checking…</p>
              </section>
              <section class="card p-4" id="set-sec-shortcuts">
                <h2 class="text-heading font-semibold">Keyboard shortcuts</h2>
                <dl class="mt-3 flex flex-col gap-1.5 text-body">
                  <div class="flex gap-2"><dt class="w-28 shrink-0"><kbd>Ctrl 1</kbd></dt><dd class="text-ink-2">Library</dd></div>
                  <div class="flex gap-2"><dt class="w-28 shrink-0"><kbd>Ctrl 2</kbd></dt><dd class="text-ink-2">Transfers</dd></div>
                  <div class="flex gap-2"><dt class="w-28 shrink-0"><kbd>Ctrl 3</kbd></dt><dd class="text-ink-2">Servers</dd></div>
                  <div class="flex gap-2"><dt class="w-28 shrink-0"><kbd>Ctrl ,</kbd></dt><dd class="text-ink-2">Settings</dd></div>
                  <div class="flex gap-2"><dt class="w-28 shrink-0"><kbd>Ctrl K</kbd></dt><dd class="text-ink-2">Focus search</dd></div>
                  <div class="flex gap-2"><dt class="w-28 shrink-0"><kbd>Ctrl F</kbd></dt><dd class="text-ink-2">Focus search</dd></div>
