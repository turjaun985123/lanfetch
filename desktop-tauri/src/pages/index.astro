            <div class="flex min-w-0 flex-1 flex-col gap-4">
              <section class="card p-4" id="set-sec-appearance">
                <h2 class="text-heading font-semibold">Appearance</h2>
                <p class="mt-0.5 text-secondary text-ink-2">How LanFetch looks on this device.</p>
                <div class="segmented mt-3" id="theme-switch" role="radiogroup" aria-label="Theme">
                  <button data-theme-choice="system" class="theme-btn" role="radio" aria-checked="true">
                    <svg class="ic ic-16" aria-hidden="true"><use href="#i-monitor" /></svg>
                    System
                  </button>
                  <button data-theme-choice="light" class="theme-btn" role="radio" aria-checked="false">
                    <svg class="ic ic-16" aria-hidden="true"><use href="#i-sun" /></svg>
                    Light
                  </button>
                  <button data-theme-choice="dark" class="theme-btn" role="radio" aria-checked="false">
                    <svg class="ic ic-16" aria-hidden="true"><use href="#i-moon" /></svg>
